---
interface Props { title: string; description: string; noindex?: boolean; image?: string }
const { title, description, noindex = false, image = '/og.jpg' } = Astro.props;
const base = Astro.site ?? new URL('https://toto-co.com');
const urlPagina = new URL(Astro.url.pathname, base).href;
const urlImagen = new URL(image, base).href;
---
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={urlPagina} />
    <meta property="og:site_name" content="Toto &Co" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={urlImagen} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Toto &Co · Tu tienda online, lista para vender" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImagen} />
    <link rel="canonical" href={urlPagina} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Serif+Text&family=Outfit:wght@100;300;400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
    <script>
      // Íconos animados: se dibujan una vez al entrar en pantalla (sin animación si el usuario la reduce)
      const iconos = document.querySelectorAll('.ico');
      if (iconos.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim-ico');
        const io = new IntersectionObserver(
          (entradas) => entradas.forEach((e) => {
            if (e.isIntersecting) {
              const el = e.target;
              el.classList.add('visto');
              io.unobserve(el);
              // Al terminar, el trazo queda sólido (evita trazos punteados en navegadores que ignoran pathLength)
              setTimeout(() => el.classList.add('listo'), 1700);
            }
          }),
          { threshold: 0.4 },
        );
        iconos.forEach((i) => io.observe(i));
      }
    </script>
  </body>
</html>

<style is:global>
  /* Toto &Co (siempre modo claro) · cinta y ticket: tinta navy del logo, papel frío, cinta amarilla de embalar */
  :root {
    --papel: #f5f6fa;
    --superficie: #ffffff;
    --tinta: #0b132b;
    --tinta-suave: #4f5776;
    --linea: #dadfeb;
    --cinta: #ff8a1f;
    --cinta-tinta: #0b132b;
    --sello: #1f5bff;
    --azul-claro: #eef3ff;
    --verde: #16a34a;
    --display: 'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --texto: 'Outfit', system-ui, -apple-system, 'Segoe UI', sans-serif;
    --serif: 'DM Serif Text', Georgia, serif;
    --mono: 'DM Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
    --ancho: 72rem;
    --gutter: clamp(1rem, 4vw, 2.5rem);
    color-scheme: light;
  }

  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } }
  body {
    margin: 0;
    background: var(--papel);
    color: var(--tinta);
    font-family: var(--texto);
    font-size: 1.0625rem;
    line-height: 1.6;
    overflow-x: clip;
  }
  img, svg { max-width: 100%; }
  a { color: inherit; text-underline-offset: 0.2em; }
  :focus-visible { outline: 3px solid var(--sello); outline-offset: 3px; border-radius: 4px; }
  h1, h2, h3 {
    font-family: var(--display);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin: 0;
  }
  p { margin: 0; }
  .envoltura { max-width: var(--ancho); margin-inline: auto; padding-inline: var(--gutter); }

  /* Íconos animados (sutiles): trazo que se dibuja al aparecer y un vaivén suave en loop */
  .ico { display: inline-grid; place-items: center; flex: none; }
  .ico svg { width: 100%; height: 100%; }
  .anim-ico .ico svg > * { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s cubic-bezier(0.65, 0, 0.35, 1); }
  .anim-ico .ico svg > *:nth-child(2) { transition-delay: 0.12s; }
  .anim-ico .ico svg > *:nth-child(3) { transition-delay: 0.24s; }
  .anim-ico .ico svg > *:nth-child(n + 4) { transition-delay: 0.36s; }
  .anim-ico .ico.visto svg > * { stroke-dashoffset: 0; }
  .anim-ico .ico.listo svg > * { stroke-dasharray: none; transition: none; }
  @keyframes ico-vaiven {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-1.5px) rotate(-5deg); }
  }
  .ico svg { animation: ico-vaiven 3.6s ease-in-out infinite; transform-origin: 50% 60%; }
  li:nth-child(3n + 2) .ico svg { animation-delay: -1.2s; }
  li:nth-child(3n + 3) .ico svg { animation-delay: -2.4s; }
  @media (prefers-reduced-motion: reduce) { .ico svg { animation: none; } }

  /* Logo: el ojito parpadea cada tanto */
  .logo-ojo { transform-box: fill-box; transform-origin: 50% 65%; animation: parpadeo 5.5s ease-in-out infinite; }
  @keyframes parpadeo {
    0%, 46%, 54%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.12); }
  }
  @media (prefers-reduced-motion: reduce) { .logo-ojo { animation: none; } }
</style>
