---
// Marco del panel de clientes: sin indexar, barra simple con el mail y "Salir".
import Base from './Base.astro';
import logo from '../data/logo.svg?raw';

interface Props { titulo: string }
const { titulo } = Astro.props;
const email = Astro.locals.email;
const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<Base title={`${titulo} · Toto &Co`} description="Panel de clientes de Toto &Co." noindex>
  <header class="pbarra">
    <div class="envoltura pbarra-in">
      <a href="/admin/invoices" class="pmarca" aria-label="Toto &Co, panel" set:html={logoSvg} />
      {email && (
        <div class="pusuario">
          <span class="pmail">{email}</span>
          <form method="post" action="/admin/logout"><button class="pbtn pbtn-linea" type="submit">Salir</button></form>
        </div>
      )}
    </div>
  </header>
  <main class="panel envoltura"><slot /></main>
</Base>

<style is:global>
  .pbarra { position: sticky; top: 0; z-index: 20; background: color-mix(in srgb, var(--papel) 85%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--linea); }
  .pbarra-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .pmarca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .pmarca svg { width: 100%; height: auto; display: block; }
  .pusuario { display: flex; align-items: center; gap: 0.75rem; min-width: 0; }
  .pmail { color: var(--tinta-suave); font-size: 0.9rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pbtn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; white-space: nowrap; cursor: pointer;
    min-height: 2.5rem; padding: 0.45rem 1.1rem; border-radius: 999px; border: 1.5px solid var(--tinta);
    background: var(--tinta); color: #fff; font: 600 0.9rem/1.2 var(--texto); text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .pbtn:hover { background: var(--sello); border-color: var(--sello); }
  .pbtn-linea { background: transparent; color: var(--tinta); }
  .pbtn-linea:hover { background: var(--tinta); border-color: var(--tinta); color: #fff; }
  .pbtn-pago { background: var(--cinta); border-color: var(--cinta); color: var(--cinta-tinta); }
  .pbtn-pago:hover { background: var(--tinta); border-color: var(--tinta); color: #fff; }
  .panel { padding-block: clamp(1.75rem, 5vw, 3.5rem) 5rem; display: grid; gap: 2.25rem; }
  .panel h1 { font-size: clamp(1.9rem, 5vw, 2.75rem); }
  .panel h2 { font-size: 1.35rem; }
  .p-suave { color: var(--tinta-suave); }
  .p-caja { background: var(--superficie); border: 1px solid var(--linea); border-radius: 1.1rem; padding: 1.1rem 1.25rem; }
  .p-campo { display: grid; gap: 0.4rem; }
  .p-campo label { font-weight: 500; font-size: 0.95rem; }
  .p-campo input { font: inherit; padding: 0.75rem 0.9rem; border-radius: 0.7rem; border: 1.5px solid var(--linea); background: #fff; color: var(--tinta); min-height: 2.9rem; width: 100%; }
  .p-campo input:focus { outline: none; border-color: var(--sello); box-shadow: 0 0 0 3px color-mix(in srgb, var(--sello) 18%, transparent); }
  .p-aviso { border-radius: 0.8rem; padding: 0.8rem 1rem; background: var(--azul-claro); color: var(--tinta); font-size: 0.95rem; }
  .p-aviso.error { background: #fff1ee; }
  .p-aviso.ok { background: #ecfaf1; }
</style>
