---
import Base from '../layouts/Base.astro';
import Barra from '../components/Barra.astro';
import logo from '../data/logo.svg?raw';
import { ico } from '../data/iconos';
import {
  contacto, links, ars, planesMensuales, incluidoSiempre, arranque, puestaAPunto, preguntasPrecios,
} from '../data/site';

const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const anio = new Date().getFullYear();
const wa = (texto: string) => `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(texto)}`;
const consulta = links.calendario || `${links.formulario}?origen=precios`;
const tiktok = `https://www.tiktok.com/@${contacto.tiktok}`;
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/></svg>';
---
<Base
  title="Precios · Toto &Co"
  description="Tu equipo de diseño y marketing digital, sin sumar costos fijos. Planes mensuales para tu tienda, tus redes y tu publicidad, sin permanencia."
>
  <Barra titulo="Precios" />

  <main>
    <div class="envoltura doc">
      <header class="intro">
        <p class="ojo">Planes mensuales</p>
        <h1>Tu equipo de diseño y marketing digital, sin sumar costos fijos</h1>
        <p class="suave bajada">
          Tu tienda, tu marca, tus redes y tu publicidad en un solo plan mensual. Un equipo que conoce tu negocio,
          no se va y te muestra qué se hizo cada semana.
        </p>
      </header>

      <section id="planes" aria-label="Planes">
        <ul class="planes">
          {planesMensuales.map((p) => {
            const href = p.linkPago || wa(`Hola! Quiero empezar con el plan ${p.nombre}.`);
            return (
              <li class="plan" id={p.id}>
                <div class="plan-top">
                  <span class="ico plan-ico" set:html={ico(p.icono)} />
                </div>
                <h2>{p.nombre}</h2>
                <p class="ahora">{ars(p.usd)} <span class="mes">por mes</span></p>
                <p class="plan-bajada">{p.bajada}</p>
                {p.suma && <p class="suma mono">Todo lo de {p.suma}, más:</p>}
                <ul class="lista">
                  {p.incluye.map((x) => <li><span set:html={check} />{x}</li>)}
                </ul>
                {p.limite && <p class="limite">{p.limite}</p>}
                <a class="boton" href={href} target="_blank" rel="noopener">
                  {p.linkPago ? 'Pagar' : 'Empezar'}<span class="b-ico" set:html={ico(p.linkPago ? 'credit-card' : 'arrow-up-right')} />
                </a>
              </li>
            );
          })}
        </ul>
      </section>

      <section id="incluido">
        <h2 class="titulo">Incluido en todos los planes</h2>
        <ul class="grilla">
          {incluidoSiempre.map((x) => (
            <li class="tarjeta">
              <span class="ico tarjeta-ico" set:html={ico(x.icono)} />
              <p>{x.texto}</p>
            </li>
          ))}
        </ul>
      </section>

      <section id="permanencia" class="permanencia">
        <span class="cinta mono">Sin permanencia</span>
        <h2 class="titulo">Cuidamos tu marca a futuro, sin atarte</h2>
        <p>
          Sabés qué viene cada mes y tenés a alguien a cargo, pero no es un compromiso de por vida. Podés dar de baja el
          servicio avisando con 30 días y volver a activarlo cuando quieras: retomamos desde donde quedamos, con el
          contexto de tu negocio.
        </p>
      </section>

      <section id="empezar">
        <h2 class="titulo">Para empezar</h2>
        <ul class="grilla">
          <li class="tarjeta tarjeta-arranque">
            <span class="ico tarjeta-ico" set:html={ico('key-round')} />
            <h3>{arranque.nombre}</h3>
            <p class="precio-chico mono">{ars(arranque.usd)} <span>única vez</span></p>
            <p class="suave">{arranque.texto}</p>
          </li>
          {puestaAPunto.map((x) => (
            <li class="tarjeta">
              <span class="ico tarjeta-ico" set:html={ico(x.icono)} />
              <h3>{x.nombre}</h3>
              <p class="precio-chico mono">{x.desde ? 'Desde ' : ''}{ars(x.usd)} <span>única vez</span></p>
              <p class="suave">{x.texto}</p>
            </li>
          ))}
        </ul>
        <p class="suave nota">¿No tenés tienda o necesitás un rediseño? Sumá una puesta a punto antes de empezar con tu plan.</p>
      </section>

      <section id="preguntas">
        <h2 class="titulo">Preguntas frecuentes</h2>
        <div class="faq">
          {preguntasPrecios.map((q) => (
            <details>
              <summary>{q.p}</summary>
              <p class="suave">{q.r}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="cierre">
        <h2>¿No sabés qué plan te conviene?</h2>
        <p>Contanos de tu negocio en una llamada corta y te recomendamos por dónde empezar.</p>
        <div class="cierre-acciones">
          <a class="boton boton-cinta" href={consulta} target="_blank" rel="noopener">Agendar consulta</a>
          <a class="boton boton-borde" href={wa('Hola! Quiero saber qué plan me conviene.')} target="_blank" rel="noopener">Escribir por WhatsApp</a>
        </div>
      </section>
    </div>
  </main>

  <footer class="pie">
    <div class="envoltura pie-in">
      <a href="/" class="marca" aria-label="Toto &amp;Co, inicio" set:html={logoSvg} />
      <ul class="pie-links">
        <li><a href={tiktok} target="_blank" rel="noopener">TikTok</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/terminos">Términos y condiciones</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
      </ul>
      <p class="suave pie-copy">© {anio} Toto &amp;Co · Buenos Aires</p>
    </div>
  </footer>
</Base>

<style>
  .suave { color: var(--tinta-suave); }
  .mono { font-family: var(--mono); }
  .ojo { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--sello); margin-bottom: 0.75rem; }

  .doc { max-width: 70rem; padding-block: clamp(2.5rem, 7vw, 5rem); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); max-width: 18ch; }
  .bajada { margin-top: 1rem; max-width: 42rem; font-size: 1.1rem; }
  section { margin-top: clamp(2.5rem, 6vw, 4.5rem); scroll-margin-top: 8rem; }
  .titulo { font-size: clamp(1.4rem, 2.8vw, 1.9rem); margin-bottom: 1.1rem; }

  /* Planes */
  .planes { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .plan {
    display: grid; gap: 0.7rem; align-content: start; grid-template-rows: auto auto auto auto auto 1fr auto auto;
    background: var(--tinta); color: #fff; border-radius: 1.25rem; padding: 1.5rem 1.4rem 1.4rem; scroll-margin-top: 8rem;
  }
  .plan-ico { width: 2.6rem; height: 2.6rem; padding: 0.6rem; border-radius: 0.8rem; background: rgba(255, 255, 255, 0.12); color: #fff; }
  .plan h2 { font-size: 1.6rem; line-height: 1.1; }
  .ahora { font: 500 clamp(1.9rem, 3.6vw, 2.4rem)/1.05 var(--display); letter-spacing: -0.02em; }
  .mes { font: 400 0.875rem/1 var(--texto); color: #c3cae3; letter-spacing: 0; }
  .plan-bajada { color: #dbe1f3; font-size: 0.975rem; }
  .suma { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--cinta); margin-top: 0.35rem; }
  .lista { list-style: none; padding: 0; margin: 0.2rem 0 0; display: grid; gap: 0.55rem; align-content: start; font-size: 0.95rem; }
  .lista li { display: grid; grid-template-columns: auto 1fr; gap: 0.55rem; align-items: start; }
  .lista span { display: inline-flex; color: var(--cinta); margin-top: 0.2rem; }
  .lista :global(svg) { width: 1.05rem; height: 1.05rem; }
  .limite { font-size: 0.85rem; color: #aab2cf; border-top: 1px solid rgba(255, 255, 255, 0.14); padding-top: 0.75rem; }
  .plan .boton { background: #fff; border-color: #fff; color: var(--tinta); margin-top: 0.4rem; }
  .plan .boton:hover { background: var(--cinta); border-color: var(--cinta); }

  /* Tarjetas claras */
  .grilla { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .tarjeta { background: var(--superficie); border: 1px solid var(--linea); border-radius: 1.1rem; padding: 1.15rem 1.2rem; display: grid; gap: 0.5rem; align-content: start; }
  .tarjeta p { font-size: 0.975rem; }
  .tarjeta h3 { font-size: 1.1rem; line-height: 1.2; }
  .tarjeta-ico { width: 2.6rem; height: 2.6rem; padding: 0.6rem; border-radius: 0.8rem; background: var(--azul-claro); color: var(--sello); }
  .tarjeta-arranque { border-color: var(--sello); box-shadow: 0 0 0 3px var(--azul-claro); }
  .precio-chico { font-weight: 500; font-size: 0.95rem; }
  .precio-chico span { color: var(--tinta-suave); font-size: 0.8125rem; }
  .nota { margin-top: 1rem; font-size: 0.925rem; }

  /* Sin permanencia */
  .permanencia { position: relative; background: var(--azul-claro); border-radius: 1.25rem; padding: clamp(1.5rem, 4vw, 2.25rem); }
  .permanencia p { max-width: 46rem; }
  .cinta {
    position: absolute; top: -0.85rem; left: 1.5rem; rotate: -3deg;
    background: var(--cinta); color: var(--tinta);
    font-weight: 600; font-size: 0.72rem; line-height: 1; text-transform: uppercase; letter-spacing: 0.08em;
    padding: 0.5rem 0.8rem; border-radius: 0.3rem; box-shadow: 0 6px 14px -6px rgba(11, 19, 43, 0.35);
  }

  /* Preguntas */
  .faq { display: grid; gap: 0.6rem; max-width: 52rem; }
  details { background: var(--superficie); border: 1px solid var(--linea); border-radius: 0.9rem; padding: 0.9rem 1.1rem; }
  summary { cursor: pointer; font-weight: 500; list-style: none; display: flex; justify-content: space-between; gap: 1rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--sello); font-weight: 600; }
  details[open] summary::after { content: '–'; }
  details p { margin-top: 0.6rem; font-size: 0.975rem; }

  /* Cierre */
  .cierre { background: var(--tinta); color: #fff; border-radius: 1.5rem; padding: clamp(1.75rem, 5vw, 3rem); display: grid; gap: 0.75rem; }
  .cierre h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); }
  .cierre p { color: #dbe3ff; max-width: 32rem; }
  .cierre-acciones { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 0.5rem; }

  /* Botones */
  .boton {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 3rem; padding: 0.75rem 1.4rem;
    border-radius: 999px; border: 1.5px solid var(--tinta); background: var(--tinta); color: #fff;
    font: 600 1rem/1.2 var(--texto); text-decoration: none; transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .boton-cinta { background: var(--cinta); border-color: var(--cinta); color: var(--tinta); }
  .boton-cinta:hover { background: #fff; border-color: #fff; }
  .boton-borde { background: transparent; border-color: rgba(255, 255, 255, 0.75); color: #fff; }
  .boton-borde:hover { background: #fff; border-color: #fff; color: var(--tinta); }
  .b-ico { display: inline-flex; width: 1.1rem; height: 1.1rem; }

  .pie { border-top: 1px solid var(--linea); padding-block: 2.5rem 5rem; margin-top: 2rem; }
  .pie-in { display: grid; gap: 1.25rem; justify-items: start; }
  .marca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .marca :global(svg) { width: 100%; height: auto; display: block; }
  .pie-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.95rem; }
  .pie-links a { text-decoration: none; }
  .pie-links a:hover { text-decoration: underline; }
  .pie-copy { font-size: 0.875rem; }
</style>
