---
import Base from '../layouts/Base.astro';
import Barra from '../components/Barra.astro';
import logo from '../data/logo.svg?raw';
import { ico } from '../data/iconos';
import {
  contacto, links, ars, serviciosMarketing, canalesMarketing,
} from '../data/site';

const canales = Object.fromEntries(canalesMarketing.map((c) => [c.id, c]));
const estrellas = '★★★★★';

const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const wa = `https://wa.me/${contacto.whatsapp}`;
const tiktok = `https://www.tiktok.com/@${contacto.tiktok}`;
const anio = new Date().getFullYear();
const consulta = links.calendario || `${links.formulario}?origen=consulta`;
const check = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/></svg>';
---
<Base
  title="Servicios de marketing · Toto &Co"
  description="Servicios mensuales de marketing de Toto &Co: Google My Business, Google Ads, email marketing, Meta y TikTok, con sus precios."
>
  <Barra titulo="Servicios de marketing" />

  <main>
    <div class="envoltura doc">
      <h1>Servicios de marketing</h1>
      <p class="suave bajada">Servicios mensuales. La inversión en anuncios se paga aparte, directo a cada plataforma.</p>

      <div class="servicios">
        {serviciosMarketing.map((m) => {
          const c = canales[m.canal];
          return (
            <article class="servicio" id={m.id}>
              <div class="servicio-texto">
                <span class="ico tarjeta-ico" set:html={ico(m.icono)} />
                <h2>{m.nombre.replace('Marketing · ', '')}</h2>
                <p class="precio-chico mono">{ars(m.usd)} <span>por mes</span></p>
                {c && <p class="gancho">{c.gancho}</p>}
                <p class="suave">{m.texto}</p>
                {c && <ul class="lista">{c.puntos.map((x) => <li><span set:html={check} />{x}</li>)}</ul>}
              </div>
              <div class="servicio-visual" aria-hidden="true">
                {m.id === 'mybusiness' && (
                  <div class="mk mk-ficha">
                    <div class="mapa"><span class="pin"></span></div>
                    <div class="ficha-cuerpo">
                      <p class="mk-titulo">Tu Marca Deco</p>
                      <p class="mk-gris"><b>4,8</b> <span class="estrellas">{estrellas}</span> (124 reseñas)</p>
                      <p class="mk-gris">Tienda de decoración · Palermo</p>
                      <p class="mk-verde">Abierto <span class="mk-gris">· Cierra a las 19 h</span></p>
                      <div class="ficha-botones"><span>Cómo llegar</span><span>Llamar</span><span>Sitio web</span></div>
                      <div class="ficha-fotos"><i></i><i></i><i></i></div>
                    </div>
                  </div>
                )}
                {m.id === 'google' && (
                  <div class="mk mk-busqueda">
                    <div class="buscador"><span class="lupa"></span>deco nórdica para el living</div>
                    <div class="resultado">
                      <p class="mk-gris"><b>Patrocinado</b></p>
                      <p class="mk-url"><i></i>tumarcadeco.com.ar</p>
                      <p class="mk-link">Deco nórdica para tu living · Envío gratis a todo el país</p>
                      <p class="mk-gris">Lámparas, almohadones y mesas. Hasta 6 cuotas. Comprá online y recibí en 48 h.</p>
                      <div class="sitelinks"><span>Lámparas</span><span>Almohadones</span><span>Ofertas</span></div>
                    </div>
                    <div class="resultado tenue"><p class="linea"></p><p class="linea corta"></p></div>
                  </div>
                )}
                {m.id === 'email' && (
                  <div class="mk mk-mail">
                    <div class="mail-cab">
                      <span class="avatar-chico">T</span>
                      <div><p class="mk-titulo">Tu Marca Deco</p><p class="mk-gris">Te guardamos tu carrito</p></div>
                    </div>
                    <div class="mail-cuerpo">
                      <p class="mk-titulo grande">¿Te olvidaste algo?</p>
                      <div class="mail-producto"><i></i><div><p>Lámpara Nórdica</p><p class="mk-gris">$ 48.900</p></div></div>
                      <span class="mk-boton">Terminar mi compra</span>
                      <p class="mk-gris chico">10% off con el código VOLVÉ</p>
                    </div>
                  </div>
                )}
                {m.id === 'meta' && (
                  <div class="mk mk-post">
                    <div class="post-cab"><span class="avatar-chico">T</span><div><p class="mk-titulo">tumarcadeco</p><p class="mk-gris">Publicidad</p></div></div>
                    <div class="post-imagen"><span class="forma uno"></span><span class="forma dos"></span></div>
                    <div class="post-cta"><span>Comprar ahora</span><span>›</span></div>
                    <div class="post-acciones"><i></i><i></i><i></i></div>
                    <p class="mk-gris"><b>tumarcadeco</b> Nueva colección de primavera. Envío gratis.</p>
                  </div>
                )}
                {m.id === 'tiktok' && (
                  <div class="mk mk-video">
                    <div class="video">
                      <span class="forma tres"></span>
                      <div class="video-lado"><i></i><i></i><i></i></div>
                      <div class="video-pie">
                        <p><b>@tumarcadeco</b></p>
                        <p>3 formas de decorar tu living</p>
                        <p class="chico">Patrocinado</p>
                        <span class="mk-boton">Comprar</span>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </article>
          );
        })}
      </div>
      <p class="nota"><a href="/marketing">Ver cómo trabajamos el marketing</a></p>

      <div class="cta">
        <a class="boton" href="/#precio">Armá tu presupuesto</a>
        <a class="boton boton-claro" href="/servicios-ecommerce">Ver servicios de ecommerce</a>
      </div>
    </div>
  </main>

  <footer class="pie">
    <div class="envoltura pie-in">
      <a href="/" class="marca" aria-label="Toto &amp;Co, inicio" set:html={logoSvg} />
      <ul class="pie-links">
        <li><a href={tiktok} target="_blank" rel="noopener">TikTok</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/terminos">Términos y condiciones</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
      </ul>
      <p class="suave pie-copy">© {anio} Toto &amp;Co · Buenos Aires</p>
    </div>
  </footer>
</Base>

<style>
  .suave { color: var(--tinta-suave); }
  .mono { font-family: var(--mono); }
  .ojo { font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--sello); margin-bottom: 0.75rem; }
  .barra {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--papel) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .barra-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .marca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .marca :global(svg) { width: 100%; height: auto; display: block; }
  .barra-acciones { display: flex; gap: 0.5rem; }
  .barra .boton-chico { min-height: 2.5rem; padding: 0.45rem 1.05rem; font-size: 0.9rem; white-space: nowrap; }
  @media (max-width: 420px) {
    .barra .marca { width: 5.5rem; }
    .barra-acciones { gap: 0.35rem; }
    .barra .boton-chico { min-height: 2.25rem; padding-inline: 0.7rem; font-size: 0.8125rem; }
  }
  .tarjeta-ico { width: 2.6rem; height: 2.6rem; padding: 0.6rem; border-radius: 0.8rem; background: var(--azul-claro); color: var(--sello); margin-bottom: 0.35rem; }
  .tarjeta-top { display: flex; align-items: center; justify-content: space-between; }

  .doc { max-width: 64rem; padding-block: clamp(2.5rem, 7vw, 5rem); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.5rem); }
  .bajada { margin-top: 0.9rem; max-width: 40rem; }
  section { margin-top: clamp(2.5rem, 6vw, 4rem); scroll-margin-top: 8.5rem; }
  .cabeza { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.5rem 1.5rem; margin-bottom: 1.25rem; }
  .cabeza p.suave { width: 100%; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
  .precio { font-size: 1.05rem; font-weight: 500; white-space: nowrap; }
  .precio span, .precio-chico span { color: var(--tinta-suave); font-size: 0.8125rem; }
  .grilla { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .dos { grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .tarjeta {
    background: var(--superficie); border: 1px solid var(--linea); border-radius: 1.1rem;
    padding: 1.15rem 1.2rem; display: grid; gap: 0.4rem; align-content: start; scroll-margin-top: 8.5rem;
  }
  .tarjeta:target { border-color: var(--sello); box-shadow: 0 0 0 3px var(--azul-claro); }
  .tarjeta h3 { font-size: 1.1rem; line-height: 1.2; }
  .tarjeta .suave { font-size: 0.95rem; }
  .num { color: var(--sello); font-size: 0.75rem; }
  .precio-chico { font-weight: 500; font-size: 0.95rem; }
  .planes .tarjeta { gap: 0.55rem; }
  .sin-titulo { margin-top: 2rem; }
  .lista { list-style: none; padding: 0; margin: 0.3rem 0 0; display: grid; gap: 0.45rem; font-size: 0.925rem; }
  .lista li { display: grid; grid-template-columns: auto 1fr; gap: 0.5rem; align-items: start; }
  .lista span { display: inline-flex; color: var(--verde); margin-top: 0.15rem; }
  .lista :global(svg) { width: 1rem; height: 1rem; }
  .nota { margin-top: 1rem; font-size: 0.875rem; }
  .nota a { color: var(--sello); font-weight: 600; }

  .cta { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: clamp(2.5rem, 6vw, 4rem); }
  .boton {
    display: inline-flex; align-items: center; justify-content: center; min-height: 3rem; padding: 0.75rem 1.4rem;
    border-radius: 999px; border: 1.5px solid var(--tinta); background: var(--tinta); color: #fff;
    font: 600 1rem/1.2 var(--texto); text-decoration: none;
  }
  .boton:hover { background: var(--sello); border-color: var(--sello); }
  .boton-claro { background: transparent; color: var(--tinta); }
  .boton-claro:hover { background: var(--tinta); color: #fff; border-color: var(--tinta); }

  .pie { border-top: 1px solid var(--linea); padding-block: 2.5rem 5rem; margin-top: 2rem; }
  .pie-in { display: grid; gap: 1.25rem; justify-items: start; }
  .pie-links { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 0.95rem; }
  .pie-links a { text-decoration: none; }
  .pie-links a:hover { text-decoration: underline; }
  .pie-copy { font-size: 0.875rem; }

  /* Cajas de servicio: texto e ilustración */
  .servicios { display: grid; gap: 1.25rem; margin-top: 2rem; }
  .servicio {
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.25rem, 4vw, 3rem); align-items: center;
    background: var(--superficie); border: 1px solid var(--linea); border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem); scroll-margin-top: 8.5rem;
  }
  .servicio:target { border-color: var(--sello); box-shadow: 0 0 0 3px var(--azul-claro); }
  @media (max-width: 760px) { .servicio { grid-template-columns: 1fr; } }
  .servicio-texto { display: grid; gap: 0.6rem; align-content: start; }
  .servicio-texto h2 { font-size: clamp(1.4rem, 2.6vw, 1.85rem); line-height: 1.1; }
  .gancho { font-weight: 600; font-size: 1.05rem; }
  .servicio-visual {
    border-radius: 1.1rem; padding: clamp(1rem, 3vw, 1.75rem); min-height: 18rem;
    display: grid; place-items: center;
    background:
      radial-gradient(60% 70% at 100% 0%, rgba(31, 91, 255, 0.14), transparent 70%),
      radial-gradient(60% 70% at 0% 100%, rgba(255, 138, 31, 0.16), transparent 70%),
      radial-gradient(circle at 1px 1px, rgba(11, 19, 43, 0.08) 1px, transparent 0) 0 0 / 16px 16px,
      var(--papel);
  }

  /* Maquetas (genéricas, sin marcas reales) */
  .mk { width: min(100%, 20rem); background: #fff; border-radius: 1rem; box-shadow: 0 20px 40px -24px rgba(11, 19, 43, 0.45); overflow: hidden; font-size: 0.8125rem; line-height: 1.35; color: #202124; }
  .mk p { margin: 0; }
  .mk-titulo { font-weight: 600; font-size: 0.95rem; }
  .mk-titulo.grande { font-size: 1.15rem; }
  .mk-gris { color: #5f6368; }
  .mk-verde { color: #188038; font-weight: 500; }
  .chico { font-size: 0.72rem; }
  .estrellas { color: #f4b400; letter-spacing: 0.05em; }
  .mk-boton { display: inline-block; background: var(--tinta); color: #fff; font-weight: 600; border-radius: 999px; padding: 0.45rem 0.9rem; font-size: 0.8rem; }
  .avatar-chico { width: 2rem; height: 2rem; flex: none; border-radius: 50%; display: grid; place-items: center; background: var(--cinta); color: var(--tinta); font-weight: 700; }

  .mapa { height: 5.5rem; position: relative; background:
      linear-gradient(90deg, transparent 47%, #fff 47% 53%, transparent 53%),
      linear-gradient(0deg, transparent 40%, #fff 40% 46%, transparent 46%),
      linear-gradient(135deg, #dfe9d8, #e8eef7); }
  .pin { position: absolute; left: 50%; top: 42%; width: 1.4rem; height: 1.4rem; background: #ea4335; border-radius: 50% 50% 50% 0; transform: translate(-50%, -50%) rotate(-45deg); box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25); }
  .pin::after { content: ''; position: absolute; inset: 0.4rem; background: #fff; border-radius: 50%; }
  .ficha-cuerpo { padding: 0.85rem 1rem 1rem; display: grid; gap: 0.3rem; }
  .ficha-botones { display: flex; gap: 0.4rem; margin-top: 0.4rem; flex-wrap: wrap; }
  .ficha-botones span { border: 1px solid #dadce0; border-radius: 999px; padding: 0.25rem 0.6rem; color: #1a73e8; font-weight: 500; font-size: 0.75rem; }
  .ficha-fotos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.35rem; margin-top: 0.5rem; }
  .ficha-fotos i { aspect-ratio: 1; border-radius: 0.5rem; background: linear-gradient(135deg, #f6e6ec, #ffd2a8); }
  .ficha-fotos i:nth-child(2) { background: linear-gradient(135deg, #eef3ff, #c8d4ff); }
  .ficha-fotos i:nth-child(3) { background: linear-gradient(135deg, #e7ebd8, #cfe0b8); }

  .mk-busqueda { padding: 0.9rem; display: grid; gap: 0.75rem; }
  .buscador { display: flex; align-items: center; gap: 0.5rem; border: 1px solid #dfe1e5; border-radius: 999px; padding: 0.5rem 0.85rem; box-shadow: 0 1px 4px rgba(32, 33, 36, 0.12); }
  .lupa { width: 0.8rem; height: 0.8rem; border: 2px solid #9aa0a6; border-radius: 50%; position: relative; flex: none; }
  .lupa::after { content: ''; position: absolute; width: 2px; height: 0.4rem; background: #9aa0a6; right: -0.25rem; bottom: -0.35rem; transform: rotate(-45deg); }
  .resultado { display: grid; gap: 0.2rem; }
  .mk-url { display: flex; align-items: center; gap: 0.4rem; color: #202124; }
  .mk-url i { width: 1rem; height: 1rem; border-radius: 50%; background: var(--cinta); }
  .mk-link { color: #1a0dab; font-size: 1rem; line-height: 1.25; }
  .sitelinks { display: flex; gap: 0.75rem; margin-top: 0.2rem; }
  .sitelinks span { color: #1a0dab; font-size: 0.78rem; }
  .tenue .linea { height: 0.55rem; border-radius: 99px; background: #eceff3; }
  .tenue .linea.corta { width: 60%; }

  .mail-cab { display: flex; gap: 0.6rem; align-items: center; padding: 0.8rem 1rem; border-bottom: 1px solid #eceff3; }
  .mail-cuerpo { padding: 1rem; display: grid; gap: 0.7rem; justify-items: start; }
  .mail-producto { display: flex; gap: 0.7rem; align-items: center; width: 100%; padding: 0.6rem; border: 1px solid #eceff3; border-radius: 0.7rem; }
  .mail-producto i { width: 3rem; height: 3rem; border-radius: 0.5rem; background: linear-gradient(135deg, #ffd2a8, #ff8a1f); flex: none; }

  .post-cab { display: flex; gap: 0.6rem; align-items: center; padding: 0.7rem 0.85rem; }
  .post-imagen { position: relative; aspect-ratio: 1; background: linear-gradient(160deg, #eef3ff, #f6e6ec); overflow: hidden; }
  .forma { position: absolute; border-radius: 50%; }
  .forma.uno { width: 45%; aspect-ratio: 1; left: 18%; top: 22%; background: radial-gradient(circle at 35% 35%, #ffd2a8, var(--cinta)); }
  .forma.dos { width: 30%; height: 50%; right: 16%; bottom: 14%; border-radius: 1rem 1rem 0.4rem 0.4rem; background: linear-gradient(#3b52ff, var(--sello)); }
  .post-cta { display: flex; justify-content: space-between; padding: 0.55rem 0.85rem; background: #f0f2f5; font-weight: 600; color: #1a73e8; }
  .post-acciones { display: flex; gap: 0.6rem; padding: 0.6rem 0.85rem 0.2rem; }
  .post-acciones i { width: 1.1rem; height: 1.1rem; border: 1.8px solid #202124; border-radius: 50%; }
  .mk-post > .mk-gris { padding: 0.2rem 0.85rem 0.85rem; }

  .mk-video { width: min(100%, 13rem); background: transparent; box-shadow: none; }
  .video { position: relative; aspect-ratio: 9 / 16; border-radius: 1.1rem; overflow: hidden; color: #fff;
    background: linear-gradient(170deg, #1a2a8f 0%, var(--tinta) 60%, #3a1d2e 100%); box-shadow: 0 20px 40px -24px rgba(11, 19, 43, 0.6); }
  .forma.tres { width: 70%; aspect-ratio: 1; left: 15%; top: 18%; background: radial-gradient(circle at 35% 35%, #ffd2a8, var(--cinta) 60%, transparent 61%); }
  .video-lado { position: absolute; right: 0.6rem; bottom: 5.5rem; display: grid; gap: 0.7rem; }
  .video-lado i { width: 1.6rem; height: 1.6rem; border-radius: 50%; background: rgba(255, 255, 255, 0.85); }
  .video-pie { position: absolute; left: 0.75rem; right: 2.8rem; bottom: 0.75rem; display: grid; gap: 0.2rem; font-size: 0.78rem; }
  .video-pie .mk-boton { background: var(--cinta); color: var(--tinta); margin-top: 0.35rem; justify-self: start; }
</style>
