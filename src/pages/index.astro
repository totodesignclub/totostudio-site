---
import Base from '../layouts/Base.astro';
import logo from '../data/logo.svg?raw';
import {
  contacto, links, ars, tipoDeCambio, notaPrecios, hero, lanzamiento, rediseno, descuentoRediseno,
  extras, marketing, casos, quienSoy, preguntas,
} from '../data/site';

const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const wa = `https://wa.me/${contacto.whatsapp}`;
const tiktok = `https://www.tiktok.com/@${contacto.tiktok}`;
const formulario = `${links.formulario}?origen=web`;
const consulta = links.calendario || `${links.formulario}?origen=consulta`;
const anio = new Date().getFullYear();

const check =
  '<svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="currentColor"/><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';
const flecha =
  '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>';
---
<Base
  title="Toto Studio · Diseño de tiendas online"
  description="Diseñamos la experiencia de tu ecommerce. Tiendas en Tienda Nube y Shopify con diseño personalizado, configuración completa y soporte continuo."
>
  <header class="barra">
    <div class="envoltura barra-in">
      <a href="#inicio" class="marca" aria-label="Toto Studio, inicio" set:html={logoSvg} />
      <nav aria-label="Secciones">
        <a href="#disenos">Diseños</a>
        <a href="#precio">Precio</a>
        <a href="#quien-soy">Quién soy</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main id="inicio">
    <!-- HERO -->
    <section class="hero envoltura">
      <div class="hero-texto">
        <h1>Diseñamos la experiencia de tu <span class="azul">ecommerce</span></h1>
        <p class="bajada">{hero.bajada}</p>
        <ul class="chips" aria-label="Plataformas">
          {hero.plataformas.map((p) => <li class="chip">{p}</li>)}
        </ul>
        <ul class="checks">
          {hero.puntos.map((p) => <li><span class="check" set:html={check} />{p}</li>)}
        </ul>
      </div>

      <aside class="tarjeta hero-tarjeta" aria-labelledby="potencia-1">
        <p class="etiqueta">Lanzamiento ecommerce</p>
        <h2 id="potencia-1">Potenciá tu marca</h2>
        <p class="hero-precio"><span class="mono">desde</span> {ars(lanzamiento.usd)}</p>
        <p class="suave">Pago único. Diseño a medida, configuración completa y 14 días de ajustes.</p>
        <div class="botones">
          <a href="#precio" class="boton boton-claro">Ver precios</a>
          <a href={consulta} class="boton" target="_blank" rel="noopener">Agendá consulta gratis</a>
        </div>
      </aside>
    </section>

    <!-- DISEÑOS REALIZADOS -->
    <section id="disenos" class="seccion envoltura" aria-labelledby="t-disenos">
      <h2 id="t-disenos" class="titulo-seccion">Diseños realizados</h2>
      <div class="casos">
        {casos.map((c) => (
          <a class="caso" href={c.url} target="_blank" rel="noopener">
            <div class="caso-visual" style={`--fondo:${c.color};--letra:${c.tinta}`}>
              <span class="caso-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="caso-marca">{c.marca}</span>
            </div>
            <div class="caso-info">
              <p class="caso-rubro mono">{c.rubro}</p>
              <p>{c.trabajo}</p>
              <span class="caso-link">Ver tienda <span set:html={flecha} /></span>
            </div>
          </a>
        ))}
        <a class="caso caso-vacio" href={formulario} target="_blank" rel="noopener">
          <div class="caso-visual">
            <span class="caso-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="caso-marca">Tu marca</span>
          </div>
          <div class="caso-info">
            <p class="caso-rubro mono">Próximo lanzamiento</p>
            <p>Contanos de tu marca y armamos la próxima.</p>
            <span class="caso-link">Empezar <span set:html={flecha} /></span>
          </div>
        </a>
      </div>
    </section>

    <!-- PRECIO -->
    <section id="precio" class="seccion envoltura" aria-labelledby="t-precio">
      <h2 id="t-precio" class="titulo-seccion">Precio</h2>

      <div class="precio-grilla">
        <div class="precio-col">
          <article class="tarjeta plan">
            <p class="etiqueta">{lanzamiento.nombre}</p>
            <p class="plan-precio">{ars(lanzamiento.usd)}</p>
            <p class="suave">Pago único · {lanzamiento.bajada}</p>
            <ul class="checks checks-chicos">
              {lanzamiento.incluye.map((i) => <li><span class="check" set:html={check} />{i}</li>)}
            </ul>

            <div class="rediseno">
              <span class="off">{descuentoRediseno}% off</span>
              <div>
                <p><strong>Con Rediseño</strong> · {ars(rediseno.usd)}</p>
                <p class="suave">{rediseno.bajada}</p>
              </div>
            </div>

            <p class="sumables-titulo">Sumá si lo necesitás</p>
            <ul class="sumables">
              {extras.map((e) => (
                <li class="chip chip-precio">
                  <span>{e.nombre}</span>
                  <span class="mono">{ars(e.usd)} {e.unidad === 'pago único' ? '' : e.unidad}</span>
                </li>
              ))}
            </ul>
          </article>

          <article class="tarjeta plan">
            <p class="etiqueta">Marketing</p>
            <p class="suave">Servicios mensuales para mantener tu tienda al día y vender más.</p>
            <ul class="marketing">
              {marketing.map((m) => (
                <li>
                  <div>
                    <p><strong>{m.nombre}</strong></p>
                    <p class="suave">{m.texto}</p>
                  </div>
                  <p class="mono marketing-precio">{m.desde ? 'desde ' : ''}{ars(m.usd)}<span>/mes</span></p>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <!-- CALCULADORA -->
        <form class="tarjeta calc" id="calculadora" aria-labelledby="t-calc" data-cambio={tipoDeCambio} data-form={links.formulario}>
          <h3 id="t-calc">Armá tu presupuesto</h3>
          <p class="suave">Tocá lo que necesitás y te mostramos el total.</p>

          <fieldset>
            <legend>Tu tienda</legend>
            <div class="opciones">
              <label class="opcion">
                <input type="radio" name="base" value="lanzamiento" data-usd={lanzamiento.usd} data-nombre="Lanzamiento Ecommerce" checked />
                <span>Lanzamiento</span><span class="mono">{ars(lanzamiento.usd)}</span>
              </label>
              <label class="opcion">
                <input type="radio" name="base" value="rediseno" data-usd={rediseno.usd} data-nombre="Rediseño" />
                <span>Rediseño</span><span class="mono">{ars(rediseno.usd)}</span>
              </label>
              <label class="opcion">
                <input type="radio" name="base" value="ninguno" data-usd="0" data-nombre="" />
                <span>Ya tengo tienda</span><span class="mono">$ 0</span>
              </label>
            </div>
          </fieldset>

          <fieldset>
            <legend>Extras</legend>
            <div class="opciones">
              {extras.map((e) => (
                <div class="opcion opcion-extra">
                  <label>
                    <input type="checkbox" name="extra" value={e.id} data-usd={e.usd} data-nombre={e.nombre} />
                    <span>{e.nombre}</span>
                  </label>
                  {e.cantidad ? (
                    <label class="cantidad">
                      <span class="sr">Cantidad de {e.cantidad}</span>
                      <input type="number" inputmode="numeric" min="1" max={e.id === 'fotos' ? 500 : 20} value={e.id === 'fotos' ? 20 : 1} data-cantidad={e.id} />
                      <span class="mono">{e.cantidad}</span>
                    </label>
                  ) : (
                    <span class="mono">{ars(e.usd)}</span>
                  )}
                </div>
              ))}
            </div>
          </fieldset>

          <fieldset>
            <legend>Marketing mensual</legend>
            <div class="opciones">
              {marketing.map((m) => (
                <label class="opcion">
                  <input type="checkbox" name="marketing" value={m.id} data-usd={m.usd} data-nombre={m.nombre} data-desde={m.desde ? '1' : ''} />
                  <span>{m.nombre}</span><span class="mono">{m.desde ? 'desde ' : ''}{ars(m.usd)}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="total" aria-live="polite">
            <div>
              <p class="mono">Pago único</p>
              <p class="total-num" data-total-unico>{ars(lanzamiento.usd)}</p>
            </div>
            <div data-fila-mensual hidden>
              <p class="mono">Por mes</p>
              <p class="total-num" data-total-mensual>$ 0</p>
            </div>
          </div>
          <button type="submit" class="boton boton-ancho">Sumar</button>
          <p class="nota">{notaPrecios}</p>
        </form>
      </div>
    </section>

    <!-- QUIÉN SOY -->
    <section id="quien-soy" class="seccion envoltura" aria-labelledby="t-quien">
      <div class="tarjeta quien">
        <div class="avatar" aria-hidden="true">T</div>
        <div>
          <h2 id="t-quien" class="titulo-seccion">Quién soy</h2>
          <p class="mono quien-rol">{quienSoy.nombre} · {quienSoy.rol}</p>
          {quienSoy.parrafos.map((p) => <p class="quien-texto">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="seccion envoltura" aria-labelledby="t-faq">
      <h2 id="t-faq" class="titulo-seccion">FAQ's</h2>
      <div class="faq">
        {preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="seccion envoltura" aria-labelledby="potencia-2">
      <div class="cta">
        <div>
          <h2 id="potencia-2">Potenciá tu marca</h2>
          <p>Contanos qué vendés y en 30 minutos vemos cómo llevar tu tienda al próximo nivel.</p>
        </div>
        <a href={consulta} class="cta-caja" target="_blank" rel="noopener">
          <span class="mono">30 minutos · sin costo</span>
          <strong>Agendá consulta gratis</strong>
          <span class="cta-flecha" set:html={flecha} />
        </a>
      </div>
    </section>
  </main>

  <a href="#inicio" class="arriba" aria-label="Volver arriba">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <footer class="pie">
    <div class="envoltura pie-in">
      <a href="#inicio" class="marca" aria-label="Toto Studio, inicio" set:html={logoSvg} />
      <ul class="pie-links">
        <li><a href={`mailto:${contacto.email}`}>{contacto.email}</a></li>
        <li><a href={wa} target="_blank" rel="noopener">WhatsApp {contacto.whatsappVisible}</a></li>
        <li><a href={tiktok} target="_blank" rel="noopener">TikTok @{contacto.tiktok}</a></li>
      </ul>
      <p class="suave pie-copy">© {anio} Toto Studio · Buenos Aires</p>
    </div>
  </footer>
</Base>

<script>
  const form = document.getElementById('calculadora') as HTMLFormElement | null;
  if (form) {
    const cambio = Number(form.dataset.cambio);
    const destino = form.dataset.form || '';
    const pesos = (usd: number) => Math.round((usd * cambio) / 1000) * 1000;
    const fmt = (n: number) => '$ ' + n.toLocaleString('es-AR');
    const unicoEl = form.querySelector('[data-total-unico]')!;
    const mensualEl = form.querySelector('[data-total-mensual]')!;
    const filaMensual = form.querySelector('[data-fila-mensual]') as HTMLElement;

    const cantidad = (id: string) => {
      const el = form.querySelector(`[data-cantidad="${id}"]`) as HTMLInputElement | null;
      return el ? Math.max(1, Math.floor(Number(el.value) || 1)) : 1;
    };

    const calcular = () => {
      let unico = 0;
      let mensual = 0;
      let desde = false;
      const items: string[] = [];

      const base = form.querySelector('input[name="base"]:checked') as HTMLInputElement | null;
      if (base && Number(base.dataset.usd)) {
        unico += pesos(Number(base.dataset.usd));
        items.push(base.dataset.nombre || '');
      }
      form.querySelectorAll<HTMLInputElement>('input[name="extra"]:checked').forEach((el) => {
        const tieneCantidad = form.querySelector(`[data-cantidad="${el.value}"]`);
        const n = tieneCantidad ? cantidad(el.value) : 1;
        unico += pesos(Number(el.dataset.usd)) * n;
        items.push(tieneCantidad ? `${el.dataset.nombre} x${n}` : el.dataset.nombre || '');
      });
      form.querySelectorAll<HTMLInputElement>('input[name="marketing"]:checked').forEach((el) => {
        mensual += pesos(Number(el.dataset.usd));
        if (el.dataset.desde) desde = true;
        items.push(`${el.dataset.nombre} (mensual)`);
      });

      unicoEl.textContent = fmt(unico);
      mensualEl.textContent = (desde ? 'desde ' : '') + fmt(mensual);
      filaMensual.hidden = mensual === 0;
      form.querySelectorAll<HTMLElement>('.opcion').forEach((o) => {
        const input = o.querySelector('input[type="radio"], input[type="checkbox"]') as HTMLInputElement | null;
        o.classList.toggle('activa', Boolean(input?.checked));
      });
      return { unico, mensual, desde, items };
    };

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.dataset.cantidad) {
        const box = form.querySelector(`input[name="extra"][value="${t.dataset.cantidad}"]`) as HTMLInputElement | null;
        if (box) box.checked = true;
      }
      calcular();
    });
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = calcular();
      const total =
        fmt(r.unico) + (r.mensual ? ` + ${r.desde ? 'desde ' : ''}${fmt(r.mensual)}/mes` : '');
      const params = new URLSearchParams({
        seleccion: r.items.join(', ') || 'Sin selección',
        total,
        origen: 'calculadora',
      });
      window.open(`${destino}?${params.toString()}`, '_blank', 'noopener');
    });
    calcular();
  }

  const arriba = document.querySelector('.arriba') as HTMLElement | null;
  if (arriba) {
    const mostrar = () => arriba.classList.toggle('visible', window.scrollY > 600);
    window.addEventListener('scroll', mostrar, { passive: true });
    mostrar();
  }
</script>

<style>
  .azul { color: var(--sello); }
  .mono { font-family: var(--mono); font-size: 0.8125rem; letter-spacing: 0.01em; }
  .suave { color: var(--tinta-suave); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  /* Barra */
  .barra {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--papel) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--linea);
  }
  .barra-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .marca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .marca :global(svg) { width: 100%; height: auto; display: block; }
  nav { display: flex; gap: 1.5rem; font-weight: 500; font-size: 0.9375rem; }
  nav a { text-decoration: none; color: var(--tinta-suave); }
  nav a:hover { color: var(--tinta); }
  @media (max-width: 640px) { nav { display: none; } }

  /* Botones */
  .boton {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0.75rem 1.4rem;
    border-radius: 999px; border: 1.5px solid var(--tinta);
    background: var(--tinta); color: #fff;
    font: 600 1rem/1.2 var(--texto); text-decoration: none; cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .boton:hover { transform: translateY(-1px); background: var(--sello); border-color: var(--sello); }
  .boton-claro { background: transparent; color: var(--tinta); }
  .boton-claro:hover { background: var(--tinta); color: #fff; border-color: var(--tinta); }
  .boton-ancho { width: 100%; }
  .botones .boton { white-space: nowrap; padding-inline: 1.1rem; }

  .tarjeta {
    background: var(--superficie);
    border: 1px solid var(--linea);
    border-radius: 1.5rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .etiqueta {
    font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--tinta-suave);
  }

  /* Hero */
  .hero {
    display: grid; gap: 2.5rem; align-items: center;
    grid-template-columns: 1.25fr 1fr;
    padding-block: clamp(3rem, 8vw, 6rem);
  }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } }
  h1 { font-size: clamp(2.6rem, 6.2vw, 4.75rem); }
  .bajada { margin-top: 1.25rem; font-size: clamp(1.0625rem, 1.6vw, 1.25rem); color: var(--tinta-suave); max-width: 34rem; }
  .chips { list-style: none; padding: 0; margin: 1.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5rem;
    padding: 0.4rem 0.9rem; border-radius: 999px;
    background: var(--superficie); border: 1px solid var(--linea);
    font-weight: 600; font-size: 0.9375rem;
  }
  .checks { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 0.6rem; }
  .checks li { display: flex; align-items: flex-start; gap: 0.6rem; font-weight: 500; }
  .check { color: var(--verde); flex: none; width: 1.25rem; height: 1.25rem; margin-top: 0.15rem; display: inline-flex; }
  .check :global(svg) { width: 100%; height: 100%; }
  .checks-chicos { margin-top: 1.25rem; }
  .checks-chicos li { font-weight: 400; font-size: 0.975rem; }

  .hero-tarjeta { box-shadow: 0 30px 60px -30px rgba(11, 19, 43, 0.25); }
  .hero-tarjeta h2 { font-size: clamp(2rem, 3.6vw, 2.75rem); margin-top: 0.5rem; }
  .hero-precio { font-family: var(--display); font-weight: 800; font-size: 1.75rem; margin-top: 1.25rem; }
  .hero-precio .mono { font-weight: 400; color: var(--tinta-suave); }
  .hero-tarjeta .suave { margin-top: 0.4rem; }
  .botones { display: grid; grid-template-columns: auto 1fr; gap: 0.6rem; margin-top: 1.5rem; }
  @media (max-width: 420px) { .botones { grid-template-columns: 1fr; } }

  /* Secciones */
  .seccion { padding-block: clamp(2.5rem, 6vw, 4.5rem); }
  .titulo-seccion { font-size: clamp(2rem, 4.5vw, 3rem); margin-bottom: 1.75rem; }

  /* Casos */
  .casos { display: grid; gap: 1rem; grid-template-columns: repeat(4, 1fr); }
  @media (max-width: 1000px) { .casos { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) {
    .casos { grid-template-columns: 1fr 1fr; gap: 0.6rem; }
    .caso-marca { font-size: 1.5rem; }
    .caso-info { font-size: 0.85rem; padding: 0.75rem; }
  }
  .caso {
    display: flex; flex-direction: column; text-decoration: none;
    background: var(--superficie); border: 1px solid var(--linea); border-radius: 1.25rem; overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .caso:hover { transform: translateY(-3px); box-shadow: 0 20px 40px -24px rgba(11, 19, 43, 0.35); }
  .caso-visual {
    position: relative; aspect-ratio: 4 / 3; display: grid; place-items: center;
    background: var(--fondo); color: var(--letra);
  }
  .caso-puntos { position: absolute; top: 0.75rem; left: 0.9rem; display: flex; gap: 0.3rem; }
  .caso-puntos i { width: 0.45rem; height: 0.45rem; border-radius: 50%; background: currentColor; opacity: 0.45; }
  .caso-marca { font-family: var(--display); font-weight: 800; font-size: 2.25rem; letter-spacing: -0.02em; }
  .caso-info { padding: 1rem 1.1rem 1.2rem; display: grid; gap: 0.35rem; flex: 1; font-size: 0.95rem; }
  .caso-rubro { color: var(--tinta-suave); }
  .caso-link { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 600; color: var(--sello); margin-top: auto; padding-top: 0.4rem; }
  .caso-link :global(svg) { width: 1rem; height: 1rem; }
  .caso-vacio .caso-visual {
    --fondo: repeating-linear-gradient(-45deg, #fff, #fff 10px, #f0f2f8 10px, #f0f2f8 20px);
    --letra: var(--tinta-suave);
    border-bottom: 1px dashed var(--linea);
  }

  /* Precio */
  .precio-grilla { display: grid; gap: 1.25rem; grid-template-columns: 1.15fr 1fr; align-items: start; }
  @media (max-width: 900px) { .precio-grilla { grid-template-columns: 1fr; } }
  .precio-col { display: grid; gap: 1.25rem; }
  .plan-precio { font-family: var(--display); font-weight: 800; font-size: clamp(2.5rem, 5vw, 3.5rem); line-height: 1; margin-top: 0.6rem; }
  .plan > .suave { margin-top: 0.5rem; }
  .rediseno {
    display: flex; gap: 1rem; align-items: center;
    margin-top: 1.5rem; padding: 1rem; border-radius: 1rem;
    background: var(--azul-claro);
  }
  .off {
    flex: none; background: var(--sello); color: #fff; border-radius: 999px;
    padding: 0.35rem 0.75rem; font: 600 0.875rem/1 var(--mono);
  }
  .rediseno .suave { font-size: 0.925rem; }
  .sumables-titulo { margin-top: 1.5rem; font-weight: 600; }
