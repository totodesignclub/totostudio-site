---
import Base from '../layouts/Base.astro';
import logo from '../data/logo.svg?raw';
import {
  contacto, links, ars, pesos, notaPrecios, hero, lanzamiento, rediseno, descuentoRediseno,
  extras, marketing, casos, quienSoy, preguntas,
  reglaCarga, disenoTienda, planesGestion, serviciosMarketing,
} from '../data/site';

const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const wa = `https://wa.me/${contacto.whatsapp}`;
const tiktok = `https://www.tiktok.com/@${contacto.tiktok}`;
const consulta = links.calendario || `${links.formulario}?origen=consulta`;
const anio = new Date().getFullYear();

const svg = (d: string, extra = '') =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${extra}>${d}</svg>`;
const check = svg('<circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/>');
const flecha = svg('<path d="M5 12h14m-6-6 6 6-6 6"/>');
const iconos: Record<string, string> = {
  home: svg('<path d="M3.5 10.5 12 4l8.5 6.5"/><path d="M5.5 9v10.5h13V9"/><path d="M10 19.5V14h4v5.5"/>'),
  paginas: svg('<rect x="4" y="3.5" width="12" height="15" rx="2"/><path d="M8 7.5h4M8 11h4M19.5 7v11.5a2 2 0 0 1-2 2H9"/>'),
  pagos: svg('<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h4"/>'),
  productos: svg('<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>'),
  video: svg('<rect x="3" y="5" width="18" height="13" rx="2.5"/><path d="m10.5 9 4.5 2.5-4.5 2.5z"/><path d="M8 21h8"/>'),
  ajustes: svg('<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>'),
};
const plataformaIcono: Record<string, string> = {
  'Tienda Nube': svg('<path d="M7 18a4 4 0 0 1-.6-7.95A5.5 5.5 0 0 1 17 9a4.5 4.5 0 0 1 .5 9z"/>'),
  Shopify: svg('<path d="M6 8h12l-1 12H7z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>'),
};
const fmt = (n: number) => '$ ' + n.toLocaleString('es-AR');

const ex = Object.fromEntries(extras.map((e) => [e.id, e]));
const sumables = [
  { nombre: ex.carga.nombre, precio: `${ars(ex.carga.usd)} ${ex.carga.unidad}` },
  { nombre: ex.fotos.nombre, precio: `${ars(ex.fotos.usd)} ${ex.fotos.unidad}` },
  { nombre: ex.identidad.nombre, precio: ars(ex.identidad.usd) },
];
const bloquesCarga = (q: number) =>
  q <= 0 ? 0 : q <= reglaCarga.tamano + reglaCarga.tolerancia ? 1 : 1 + Math.ceil((q - reglaCarga.tamano - reglaCarga.tolerancia) / reglaCarga.tamano);
const totalUnicoInicial = pesos(disenoTienda.usd) + bloquesCarga(reglaCarga.inicial) * pesos(ex.carga.usd);
const totalMensualInicial = pesos(planesGestion[0].usd);
const iconoCalendario = svg('<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/>');
const iconoWhatsapp = svg('<path d="M4 20l1.3-3.9A8.5 8.5 0 1 1 8 18.8z"/><path d="M9.2 8.6c.2-.4.6-.5 1-.4l.6 1.4c.1.3 0 .5-.2.7l-.4.4c.5 1 1.3 1.8 2.3 2.3l.4-.4c.2-.2.5-.3.7-.2l1.4.6c.1.4 0 .8-.4 1-.9.6-2.3.5-3.9-.7a8 8 0 0 1-1.9-1.9c-1.2-1.6-1.3-3-.6-3.8z"/>');
const iconoAfuera = svg('<path d="M7 17 17 7M9 7h8v8"/>');
const unicos = [
  { id: 'fotos', nombre: ex.fotos.nombre, sub: 'Pack de 25 fotos · única vez', usd: ex.fotos.usd, activo: false },
  { id: 'identidad', nombre: ex.identidad.nombre, sub: 'Logo, paleta y tipografías · única vez', usd: ex.identidad.usd, activo: false },
];
---
<Base
  title={"Toto &Co · Diseño de tiendas online"}
  description="Diseñamos la experiencia de tu ecommerce. Tiendas en Tienda Nube y Shopify con diseño personalizado, configuración completa y soporte continuo."
>
  <header class="barra">
    <div class="envoltura barra-in">
      <a href="#inicio" class="marca" aria-label="Toto &amp;Co, inicio" set:html={logoSvg} />
      <nav aria-label="Secciones">
        <a href="#disenos">Diseños</a>
        <a href="#precio">Precio</a>
        <a href="/marketing">Marketing</a>
        <a href="#quien-soy">Quién soy</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main id="inicio">
    <!-- HERO -->
    <section class="hero-zona">
      <div class="hero envoltura">
        <div class="hero-texto">
          <p class="ojo"><span class="punto"></span>Estudio de ecommerce · Buenos Aires</p>
          <h1>Diseñamos la experiencia de tu <span class="azul">ecommerce</span></h1>
          <p class="bajada">{hero.bajada}</p>
          <ul class="checks">
            {hero.puntos.map((p) => <li><span class="check" set:html={check} />{p}</li>)}
          </ul>
        </div>

        <aside class="hero-tarjeta" aria-labelledby="potencia-1">
          <span class="cinta" aria-hidden="true">Tendencias 2026</span>
          <h2 id="potencia-1">Potenciá tu marca</h2>
          <p class="suave hero-sub">Tiendas online en</p>
          <ul class="chips" aria-label="Plataformas">
            {hero.plataformas.map((p) => <li class="chip"><span class="chip-icono" set:html={plataformaIcono[p]} />{p}</li>)}
          </ul>
          <div class="botones">
            <a href="#precio" class="boton boton-claro">Ver precios</a>
            <a href={consulta} class="boton" target="_blank" rel="noopener">Agendá consulta gratis</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- DISEÑOS REALIZADOS -->
    <section id="disenos" class="seccion" aria-labelledby="t-disenos">
      <div class="envoltura">
        <p class="ojo">01 · Portfolio</p>
        <h2 id="t-disenos" class="titulo-seccion">Diseños realizados</h2>
      </div>
      <div class="carrusel" aria-label="Sitios de clientes">
        <div class="pista">
          {[0, 1].map((vuelta) => (
            <ul class="grupo-casos" aria-hidden={vuelta === 1 ? 'true' : undefined}>
              {casos.map((c) => (
                <li>
                  <a class="caso" href={c.url} target="_blank" rel="noopener" tabindex={vuelta === 1 ? -1 : undefined}>
                    <div class="navegador">
                      <span class="caso-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
                      <span class="url mono">{c.dominio}</span>
                    </div>
                    <div class="caso-visual" style={`--fondo:${c.color};--letra:${c.tinta}`}>
                      <span class="caso-marca">{c.marca}</span>
                      <img src={`/previews/${c.slug}.jpg`} alt={`Vista previa del sitio de ${c.marca}`} loading="lazy" decoding="async" onerror="this.remove()" />
                    </div>
                    <div class="caso-info">
                      <div>
                        <p class="caso-nombre">{c.marca}</p>
                        <p class="caso-rubro mono">{c.rubro}</p>
                      </div>
                      <span class="caso-link" set:html={flecha} />
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <!-- PRECIO -->
    <section id="precio" class="seccion envoltura" aria-labelledby="t-precio">
      <p class="ojo">02 · Inversión</p>
      <h2 id="t-precio" class="titulo-seccion">Precio</h2>

      <div class="precio-grilla">
        <div class="precio-col">
          <article class="tarjeta plan plan-principal">
            <p class="etiqueta">{lanzamiento.nombre}</p>
            <p class="plan-precio"><span class="resaltado">{ars(lanzamiento.usd)}</span></p>
            <p class="suave">Pago único · {lanzamiento.bajada}</p>
            <ul class="incluye">
              {lanzamiento.incluye.map((i) => <li><span class="incluye-icono" set:html={iconos[i.icono]} />{i.texto}</li>)}
            </ul>

            <div class="rediseno">
              <p class="rediseno-pregunta">¿Ya tenés una tienda funcionando?</p>
              <div class="rediseno-fila">
                <span class="off">{descuentoRediseno}% off</span>
                <div>
                  <p><strong>Rediseño</strong> · <span class="nowrap">{ars(rediseno.usd)}</span></p>
                  <p class="suave">{rediseno.bajada}</p>
                </div>
              </div>
            </div>

            <p class="sumables-titulo">Sumá si lo necesitás</p>
            <ul class="sumables">
              {sumables.map((s) => (
                <li><span>{s.nombre}</span><span class="mono">{s.precio}</span></li>
              ))}
            </ul>
          </article>

          <article class="tarjeta plan">
            <p class="etiqueta">Marketing</p>
            <p class="suave">Servicios mensuales para mantener tu tienda al día y vender más.</p>
            <ul class="marketing">
              {marketing.map((m) => (
                <li>
                  <div>
                    <p><strong>{m.nombre}</strong></p>
                    <p class="suave">{m.texto}</p>
                  </div>
                  <p class="mono marketing-precio">{m.desde ? 'desde ' : ''}{ars(m.usd)}<span>/mes</span></p>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <!-- CALCULADORA -->
        <form class="calc" id="calculadora" aria-labelledby="t-calc" data-form={links.formulario} data-wa={contacto.whatsapp}>
          <h3 id="t-calc">Armá tu presupuesto</h3>

          <div class="items">
            <div class="item" data-item="diseno" data-tipo="unico" data-pesos={pesos(disenoTienda.usd)} data-nombre={disenoTienda.nombre}>
              <div class="item-info">
                <p class="item-nombre" data-on={disenoTienda.nombre} data-off="Ya tengo tienda">{disenoTienda.nombre}</p>
                <p class="item-sub">Única vez</p>
                <a class="ver-detalle" href="/servicios#diseno" target="_blank" rel="noopener">Ver detalle <span set:html={iconoAfuera} /></a>
              </div>
              <p class="item-precio mono"><span data-monto>{ars(disenoTienda.usd)}</span></p>
              <label class="switch"><input type="checkbox" role="switch" checked aria-label={`Incluir ${disenoTienda.nombre}`} /><span></span></label>
            </div>

            <div class="item" data-item="carga" data-tipo="unico" data-bloque={pesos(ex.carga.usd)} data-tamano={reglaCarga.tamano} data-tolerancia={reglaCarga.tolerancia} data-nombre={ex.carga.nombre}>
              <div class="item-info">
                <p class="item-nombre">{ex.carga.nombre}</p>
                <p class="item-sub">{ars(ex.carga.usd)} cada 50 productos · única vez</p>
                <div class="stepper">
                  <button type="button" data-paso={-reglaCarga.paso} aria-label={`Restar ${reglaCarga.paso} productos`}>−</button>
                  <input type="number" inputmode="numeric" min="1" max="5000" step="1" value={reglaCarga.inicial} aria-label="Cantidad de productos" data-cantidad />
                  <button type="button" data-paso={reglaCarga.paso} aria-label={`Sumar ${reglaCarga.paso} productos`}>+</button>
                  <span>productos</span>
                </div>
              </div>
              <p class="item-precio mono"><span data-monto>{fmt(bloquesCarga(reglaCarga.inicial) * pesos(ex.carga.usd))}</span></p>
              <label class="switch"><input type="checkbox" role="switch" checked aria-label={`Incluir ${ex.carga.nombre}`} /><span></span></label>
            </div>

            {unicos.map((u) => (
              <div class="item" data-item={u.id} data-tipo="unico" data-pesos={pesos(u.usd)} data-nombre={u.nombre}>
                <div class="item-info">
                  <p class="item-nombre">{u.nombre}</p>
                  <p class="item-sub">{u.sub}</p>
                </div>
                <p class="item-precio mono"><span data-monto>{ars(u.usd)}</span></p>
                <label class="switch"><input type="checkbox" role="switch" checked={u.activo} aria-label={`Incluir ${u.nombre}`} /><span></span></label>
              </div>
            ))}

            <div class="item" data-item="gestion" data-tipo="mensual" data-nombre="Gestión tienda">
              <div class="item-info">
                <p class="item-nombre">Gestión tienda</p>
                <span class="select select-chico">
                  <select data-plan aria-label="Plan de gestión">
                    {planesGestion.map((g, i) => (
                      <option value={g.corto} data-pesos={pesos(g.usd)} selected={i === 0}>{g.corto} · {ars(g.usd)}/mes</option>
                    ))}
                  </select>
                </span>
                <a class="ver-detalle" href="/servicios#gestion" target="_blank" rel="noopener">Ver detalle <span set:html={iconoAfuera} /></a>
              </div>
              <p class="item-precio mono"><span data-monto>{ars(planesGestion[0].usd)}</span><small>/mes</small></p>
              <label class="switch"><input type="checkbox" role="switch" checked aria-label="Incluir gestión de tienda" /><span></span></label>
            </div>
          </div>

          <details class="mas">
            <summary>Ver también servicio de Marketing</summary>
            <div class="items">
              {serviciosMarketing.map((m) => (
                <div class="item" data-item={m.id} data-tipo="mensual" data-pesos={pesos(m.usd)} data-nombre={m.nombre}>
                  <div class="item-info">
                    <p class="item-nombre">{m.nombre}</p>
                    <p class="item-sub">Por mes</p>
                    <a class="ver-detalle" href={`/servicios#${m.id}`} target="_blank" rel="noopener">Ver detalle <span set:html={iconoAfuera} /></a>
                  </div>
                  <p class="item-precio mono"><span data-monto>{ars(m.usd)}</span><small>/mes</small></p>
                  <label class="switch"><input type="checkbox" role="switch" aria-label={`Incluir ${m.nombre}`} /><span></span></label>
                </div>
              ))}
            </div>
            <p class="nota">La inversión en anuncios se paga aparte, directo a cada plataforma.</p>
          </details>

          <div class="total" aria-live="polite">
            <div>
              <p class="mono">Pago único</p>
              <p class="total-num" data-total-unico>{fmt(totalUnicoInicial)}</p>
            </div>
            <div data-fila-mensual>
              <p class="mono">Por mes</p>
              <p class="total-num" data-total-mensual>{fmt(totalMensualInicial)}</p>
            </div>
          </div>
          <div class="acciones">
            <button type="submit" class="boton boton-naranja"><span set:html={iconoCalendario} />Agendar consulta gratis</button>
            <a class="boton boton-borde" href={wa} target="_blank" rel="noopener" data-wa-link><span set:html={iconoWhatsapp} />Consultar</a>
          </div>
          <p class="nota">{notaPrecios}</p>
        </form>
      </div>
    </section>

    <!-- QUIÉN SOY -->
    <section id="quien-soy" class="seccion envoltura" aria-labelledby="t-quien">
      <div class="tarjeta quien">
        <div class="avatar" aria-hidden="true"><span>T</span></div>
        <div>
          <p class="ojo">03 · Detrás del estudio</p>
          <h2 id="t-quien" class="titulo-seccion">Quién soy</h2>
          <p class="mono quien-rol">{quienSoy.nombre} · {quienSoy.rol}</p>
          {quienSoy.parrafos.map((p) => <p class="quien-texto">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="seccion envoltura faq-zona" aria-labelledby="t-faq">
      <div class="faq-titulo">
        <p class="ojo">04 · Dudas</p>
        <h2 id="t-faq" class="titulo-seccion">FAQ's</h2>
        <p class="suave">¿No encontrás tu respuesta? Escribinos por <a href={wa} target="_blank" rel="noopener">WhatsApp</a>.</p>
      </div>
      <div class="faq">
        {preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="seccion envoltura" aria-labelledby="potencia-2">
      <div class="cta">
        <span class="forma forma-1" aria-hidden="true"></span>
        <span class="forma forma-2" aria-hidden="true"></span>
        <div class="cta-texto">
          <h2 id="potencia-2">Potenciá tu marca</h2>
          <p>Contanos qué vendés y en 30 minutos vemos cómo llevar tu tienda al próximo nivel.</p>
        </div>
        <a href={consulta} class="cta-caja" target="_blank" rel="noopener">
          <span class="mono">30 minutos · sin costo</span>
          <strong>Agendá consulta gratis</strong>
          <span class="cta-flecha" set:html={flecha} />
        </a>
      </div>
    </section>
  </main>

  <a href="#inicio" class="arriba" aria-label="Volver arriba">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <footer class="pie">
    <div class="envoltura pie-in">
      <a href="#inicio" class="marca" aria-label="Toto &amp;Co, inicio" set:html={logoSvg} />
      <ul class="pie-links">
        <li><a href={`mailto:${contacto.email}`}>{contacto.email}</a></li>
        <li><a href={wa} target="_blank" rel="noopener">WhatsApp {contacto.whatsappVisible}</a></li>
        <li><a href={tiktok} target="_blank" rel="noopener">TikTok @{contacto.tiktok}</a></li>
        <li><a href="/contacto">Contacto</a></li>
        <li><a href="/terminos">Términos y condiciones</a></li>
        <li><a href="/privacidad">Política de privacidad</a></li>
      </ul>
      <p class="suave pie-copy">© {anio} Toto &amp;Co · Buenos Aires</p>
    </div>
  </footer>
</Base>

<script>
  const form = document.getElementById('calculadora') as HTMLFormElement | null;
  if (form) {
    const destino = form.dataset.form || '';
    const numeroWa = form.dataset.wa || '';
    const fmt = (n: number) => '$ ' + n.toLocaleString('es-AR');
    const unicoEl = form.querySelector('[data-total-unico]')!;
    const mensualEl = form.querySelector('[data-total-mensual]')!;
    const filaMensual = form.querySelector('[data-fila-mensual]') as HTMLElement;
    const waLink = form.querySelector('[data-wa-link]') as HTMLAnchorElement;
    const items = [...form.querySelectorAll<HTMLElement>('.item')];
    const cantidadEl = form.querySelector('[data-cantidad]') as HTMLInputElement;

    const leerCantidad = () => {
      const q = Math.max(1, Math.min(5000, Math.round(Number(cantidadEl.value) || 1)));
      return q;
    };
    const bloques = (q: number, tam: number, tol: number) => (q <= tam + tol ? 1 : 1 + Math.ceil((q - tam - tol) / tam));

    const calcular = () => {
      let unico = 0;
      let mensual = 0;
      const elegidos: string[] = [];

      items.forEach((item) => {
        const sw = item.querySelector<HTMLInputElement>('input[role="switch"]')!;
        const montoEl = item.querySelector('[data-monto]') as HTMLElement;
        const on = sw.checked;
        let monto = Number(item.dataset.pesos || 0);
        let etiqueta = item.dataset.nombre || '';

        if (item.dataset.item === 'carga') {
          const q = leerCantidad();
          monto = bloques(q, Number(item.dataset.tamano), Number(item.dataset.tolerancia)) * Number(item.dataset.bloque);
          etiqueta = `${etiqueta} (${q} productos)`;
        }
        if (item.dataset.item === 'gestion') {
          const op = item.querySelector<HTMLSelectElement>('select[data-plan]')!.selectedOptions[0];
          monto = Number(op.dataset.pesos || 0);
          etiqueta = `${etiqueta} '${op.value}'`;
        }
        if (item.dataset.item === 'diseno') {
          const nombre = item.querySelector('.item-nombre') as HTMLElement;
          nombre.textContent = on ? nombre.dataset.on || '' : nombre.dataset.off || '';
          if (!on) elegidos.push('Ya tengo tienda');
        }

        montoEl.textContent = fmt(monto);
        item.classList.toggle('apagado', !on);
        if (!on) return;
        if (item.dataset.tipo === 'mensual') {
          mensual += monto;
          elegidos.push(`${etiqueta} (mensual)`);
        } else {
          unico += monto;
          elegidos.push(etiqueta);
        }
      });

      unicoEl.textContent = fmt(unico);
      mensualEl.textContent = fmt(mensual);
      filaMensual.hidden = mensual === 0;
      const total = fmt(unico) + (mensual ? ` + ${fmt(mensual)}/mes` : '');
      const texto = `Hola, armé un presupuesto en toto-co.com:\n${elegidos.map((e) => '• ' + e).join('\n')}\nTotal: ${total}`;
      waLink.href = `https://wa.me/${numeroWa}?text=${encodeURIComponent(texto)}`;
      return { elegidos, total };
    };

    const activar = (el: Element) => {
      const sw = el.closest('.item')?.querySelector<HTMLInputElement>('input[role="switch"]');
      if (sw) sw.checked = true;
    };

    form.querySelectorAll<HTMLButtonElement>('[data-paso]').forEach((b) =>
      b.addEventListener('click', () => {
        cantidadEl.value = String(Math.max(1, leerCantidad() + Number(b.dataset.paso)));
        activar(b);
        calcular();
      }),
    );
    cantidadEl.addEventListener('input', () => {
      activar(cantidadEl);
      calcular();
    });
    cantidadEl.addEventListener('blur', () => {
      cantidadEl.value = String(leerCantidad());
      calcular();
    });
    form.addEventListener('change', (e) => {
      const t = e.target as HTMLElement;
      if (t.matches('select[data-plan]')) activar(t);
      calcular();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = calcular();
      const params = new URLSearchParams({
        seleccion: r.elegidos.join('\n') || 'Sin selección',
        total: r.total,
        origen: 'calculadora',
      });
      window.open(`${destino}?${params.toString()}`, '_blank', 'noopener');
    });
    calcular();
  }

  const arriba = document.querySelector('.arriba') as HTMLElement | null;
  if (arriba) {
    const mostrar = () => arriba.classList.toggle('visible', window.scrollY > 600);
    window.addEventListener('scroll', mostrar, { passive: true });
    mostrar();
  }
  // Carrusel: avanza solo, se frena con hover y se puede arrastrar
  const carrusel = document.querySelector('.carrusel') as HTMLElement | null;
  const pista = carrusel?.querySelector('.pista') as HTMLElement | null;
  if (carrusel && pista && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    carrusel.classList.add('js');
    const velocidad = 70; // px por segundo
    let x = 0;
    let mitad = pista.scrollWidth / 2;
    let pausado = false;
    let arrastre: { id: number; inicio: number; base: number; movio: boolean } | null = null;
    let anterior = performance.now();

    const envolver = () => {
      if (x <= -mitad) x += mitad;
      if (x > 0) x -= mitad;
    };
    const cuadro = (t: number) => {
      const dt = Math.min(t - anterior, 64) / 1000;
      anterior = t;
      if (!pausado && !arrastre) x -= velocidad * dt;
      envolver();
      pista.style.transform = `translate3d(${x}px,0,0)`;
      requestAnimationFrame(cuadro);
    };
    requestAnimationFrame(cuadro);
    addEventListener('resize', () => (mitad = pista.scrollWidth / 2));

    carrusel.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') pausado = true; });
    carrusel.addEventListener('pointerleave', () => (pausado = false));
    carrusel.addEventListener('focusin', () => (pausado = true));
    carrusel.addEventListener('focusout', () => (pausado = false));

    carrusel.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      arrastre = { id: e.pointerId, inicio: e.clientX, base: x, movio: false };
    });
    carrusel.addEventListener('pointermove', (e) => {
      if (!arrastre || e.pointerId !== arrastre.id) return;
      const dx = e.clientX - arrastre.inicio;
      if (!arrastre.movio && Math.abs(dx) > 6) {
        arrastre.movio = true;
        carrusel.classList.add('arrastrando');
        carrusel.setPointerCapture(e.pointerId);
      }
      if (arrastre.movio) x = arrastre.base + dx;
    });
    const soltar = (e: PointerEvent) => {
      if (!arrastre || e.pointerId !== arrastre.id) return;
      const movio = arrastre.movio;
      arrastre = null;
      if (movio) {
        // evita que el click al soltar abra el sitio
        const bloquear = (c: Event) => { c.preventDefault(); c.stopPropagation(); };
        carrusel.addEventListener('click', bloquear, { capture: true, once: true });
        setTimeout(() => carrusel.removeEventListener('click', bloquear, { capture: true }), 300);
        setTimeout(() => carrusel.classList.remove('arrastrando'), 0);
      }
    };
    carrusel.addEventListener('pointerup', soltar);
    carrusel.addEventListener('pointercancel', soltar);
    carrusel.addEventListener('dragstart', (e) => e.preventDefault());
  }

</script>

