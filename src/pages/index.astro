---
import Base from '../layouts/Base.astro';
import logo from '../data/logo.svg?raw';
import {
  contacto, links, ars, pesos, notaPrecios, hero, lanzamiento, rediseno, descuentoRediseno,
  extras, marketing, casos, quienSoy, preguntas,
} from '../data/site';

const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const wa = `https://wa.me/${contacto.whatsapp}`;
const tiktok = `https://www.tiktok.com/@${contacto.tiktok}`;
const consulta = links.calendario || `${links.formulario}?origen=consulta`;
const anio = new Date().getFullYear();

const svg = (d: string, extra = '') =>
  `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ${extra}>${d}</svg>`;
const check = svg('<circle cx="12" cy="12" r="9.2"/><path d="m8 12.3 2.7 2.7L16.2 9.5"/>');
const flecha = svg('<path d="M5 12h14m-6-6 6 6-6 6"/>');
const iconos: Record<string, string> = {
  home: svg('<path d="M3.5 10.5 12 4l8.5 6.5"/><path d="M5.5 9v10.5h13V9"/><path d="M10 19.5V14h4v5.5"/>'),
  paginas: svg('<rect x="4" y="3.5" width="12" height="15" rx="2"/><path d="M8 7.5h4M8 11h4M19.5 7v11.5a2 2 0 0 1-2 2H9"/>'),
  pagos: svg('<rect x="3" y="5.5" width="18" height="13" rx="2.5"/><path d="M3 10h18M7 15h4"/>'),
  productos: svg('<path d="m12 3 8 4.5v9L12 21l-8-4.5v-9z"/><path d="m4 7.5 8 4.5 8-4.5M12 12v9"/>'),
  video: svg('<rect x="3" y="5" width="18" height="13" rx="2.5"/><path d="m10.5 9 4.5 2.5-4.5 2.5z"/><path d="M8 21h8"/>'),
  ajustes: svg('<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>'),
};
const plataformaIcono: Record<string, string> = {
  'Tienda Nube': svg('<path d="M7 18a4 4 0 0 1-.6-7.95A5.5 5.5 0 0 1 17 9a4.5 4.5 0 0 1 .5 9z"/>'),
  Shopify: svg('<path d="M6 8h12l-1 12H7z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>'),
};
const fmt = (n: number) => '$ ' + n.toLocaleString('es-AR');

const ex = Object.fromEntries(extras.map((e) => [e.id, e]));
const mk = Object.fromEntries(marketing.map((m) => [m.id, m]));
type Opcion = { id: string; nombre: string; detalle: string; pesos: number; grupo?: string; desde?: boolean; definir?: boolean };
const opcionesExtras: Opcion[] = [
  { id: 'carga50', nombre: 'Carga de productos', detalle: 'Hasta 50 productos', pesos: pesos(ex.carga.usd), grupo: 'carga' },
  { id: 'carga100', nombre: 'Carga de productos', detalle: 'Hasta 100 productos', pesos: pesos(ex.carga.usd) * 2, grupo: 'carga' },
  { id: 'carga+', nombre: 'Carga de productos', detalle: 'Más de 100 productos', pesos: 0, grupo: 'carga', definir: true },
  { id: 'fotos25', nombre: 'Edición de fotos con IA', detalle: '25 fotos', pesos: pesos(ex.fotos.usd) * 25, grupo: 'fotos' },
  { id: 'fotos50', nombre: 'Edición de fotos con IA', detalle: '50 fotos', pesos: pesos(ex.fotos.usd) * 50, grupo: 'fotos' },
  { id: 'fotos+', nombre: 'Edición de fotos con IA', detalle: 'Más de 50 fotos', pesos: 0, grupo: 'fotos', definir: true },
  { id: 'identidad', nombre: 'Mini identidad de marca', detalle: 'Logo, paleta y tipografías', pesos: pesos(ex.identidad.usd) },
];
const opcionesMarketing: Opcion[] = [
  { id: 'gestion', nombre: mk.gestion.nombre, detalle: 'Por mes', pesos: pesos(mk.gestion.usd) },
  { id: 'google', nombre: mk.google.nombre, detalle: 'Por mes', pesos: pesos(mk.google.usd) },
  { id: 'email', nombre: mk.email.nombre, detalle: 'Por mes', pesos: pesos(mk.email.usd) },
  { id: 'meta', nombre: 'Meta Ads', detalle: 'Por mes, desde', pesos: pesos(mk.social.usd), desde: true },
  { id: 'tiktok', nombre: 'TikTok Ads', detalle: 'Por mes, desde', pesos: pesos(mk.social.usd), desde: true },
];
const multis = [
  { id: 'extras', titulo: 'Extras', vacio: 'Elegí los extras', tipo: 'unico', opciones: opcionesExtras },
  { id: 'marketing', titulo: 'Marketing mensual', vacio: 'Elegí servicios de marketing', tipo: 'mensual', opciones: opcionesMarketing },
];
const sumables = [
  { nombre: ex.carga.nombre, precio: `${ars(ex.carga.usd)} cada 50 productos` },
  { nombre: ex.fotos.nombre, precio: `${ars(ex.fotos.usd)} por foto` },
  { nombre: ex.identidad.nombre, precio: ars(ex.identidad.usd) },
];
---
<Base
  title="Toto Studio · Diseño de tiendas online"
  description="Diseñamos la experiencia de tu ecommerce. Tiendas en Tienda Nube y Shopify con diseño personalizado, configuración completa y soporte continuo."
>
  <header class="barra">
    <div class="envoltura barra-in">
      <a href="#inicio" class="marca" aria-label="Toto Studio, inicio" set:html={logoSvg} />
      <nav aria-label="Secciones">
        <a href="#disenos">Diseños</a>
        <a href="#precio">Precio</a>
        <a href="#quien-soy">Quién soy</a>
        <a href="#faq">FAQ</a>
      </nav>
    </div>
  </header>

  <main id="inicio">
    <!-- HERO -->
    <section class="hero-zona">
      <div class="hero envoltura">
        <div class="hero-texto">
          <p class="ojo"><span class="punto"></span>Estudio de ecommerce · Buenos Aires</p>
          <h1>Diseñamos la experiencia de tu <span class="azul">ecommerce</span></h1>
          <p class="bajada">{hero.bajada}</p>
          <ul class="checks">
            {hero.puntos.map((p) => <li><span class="check" set:html={check} />{p}</li>)}
          </ul>
        </div>

        <aside class="hero-tarjeta" aria-labelledby="potencia-1">
          <span class="cinta" aria-hidden="true">Tendencias 2026</span>
          <h2 id="potencia-1">Potenciá tu marca</h2>
          <p class="suave hero-sub">Tiendas online en</p>
          <ul class="chips" aria-label="Plataformas">
            {hero.plataformas.map((p) => <li class="chip"><span class="chip-icono" set:html={plataformaIcono[p]} />{p}</li>)}
          </ul>
          <div class="botones">
            <a href="#precio" class="boton boton-claro">Ver precios</a>
            <a href={consulta} class="boton" target="_blank" rel="noopener">Agendá consulta gratis</a>
          </div>
        </aside>
      </div>
    </section>

    <!-- DISEÑOS REALIZADOS -->
    <section id="disenos" class="seccion" aria-labelledby="t-disenos">
      <div class="envoltura">
        <p class="ojo">01 · Portfolio</p>
        <h2 id="t-disenos" class="titulo-seccion">Diseños realizados</h2>
      </div>
      <div class="carrusel" aria-label="Sitios de clientes">
        <div class="pista">
          {[0, 1].map((vuelta) => (
            <ul class="grupo-casos" aria-hidden={vuelta === 1 ? 'true' : undefined}>
              {casos.map((c) => (
                <li>
                  <a class="caso" href={c.url} target="_blank" rel="noopener" tabindex={vuelta === 1 ? -1 : undefined}>
                    <div class="navegador">
                      <span class="caso-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
                      <span class="url mono">{c.url.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</span>
                    </div>
                    <div class="caso-visual" style={`--fondo:${c.color};--letra:${c.tinta}`}>
                      <span class="caso-marca">{c.marca}</span>
                      <img src={`/previews/${c.slug}.jpg`} alt={`Vista previa del sitio de ${c.marca}`} loading="lazy" decoding="async" onerror="this.remove()" />
                    </div>
                    <div class="caso-info">
                      <div>
                        <p class="caso-nombre">{c.marca}</p>
                        <p class="caso-rubro mono">{c.rubro}</p>
                      </div>
                      <span class="caso-link" set:html={flecha} />
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </section>

    <!-- PRECIO -->
    <section id="precio" class="seccion envoltura" aria-labelledby="t-precio">
      <p class="ojo">02 · Inversión</p>
      <h2 id="t-precio" class="titulo-seccion">Precio</h2>

      <div class="precio-grilla">
        <div class="precio-col">
          <article class="tarjeta plan plan-principal">
            <p class="etiqueta">{lanzamiento.nombre}</p>
            <p class="plan-precio"><span class="resaltado">{ars(lanzamiento.usd)}</span></p>
            <p class="suave">Pago único · {lanzamiento.bajada}</p>
            <ul class="incluye">
              {lanzamiento.incluye.map((i) => <li><span class="incluye-icono" set:html={iconos[i.icono]} />{i.texto}</li>)}
            </ul>

            <div class="rediseno">
              <p class="rediseno-pregunta">¿Ya tenés una tienda funcionando?</p>
              <div class="rediseno-fila">
                <span class="off">{descuentoRediseno}% off</span>
                <div>
                  <p><strong>Rediseño</strong> · <span class="nowrap">{ars(rediseno.usd)}</span></p>
                  <p class="suave">{rediseno.bajada}</p>
                </div>
              </div>
            </div>

            <p class="sumables-titulo">Sumá si lo necesitás</p>
            <ul class="sumables">
              {sumables.map((s) => (
                <li><span>{s.nombre}</span><span class="mono">{s.precio}</span></li>
              ))}
            </ul>
          </article>

          <article class="tarjeta plan">
            <p class="etiqueta">Marketing</p>
            <p class="suave">Servicios mensuales para mantener tu tienda al día y vender más.</p>
            <ul class="marketing">
              {marketing.map((m) => (
                <li>
                  <div>
                    <p><strong>{m.nombre}</strong></p>
                    <p class="suave">{m.texto}</p>
                  </div>
                  <p class="mono marketing-precio">{m.desde ? 'desde ' : ''}{ars(m.usd)}<span>/mes</span></p>
                </li>
              ))}
            </ul>
          </article>
        </div>

        <!-- CALCULADORA -->
        <form class="calc" id="calculadora" aria-labelledby="t-calc" data-form={links.formulario}>
          <h3 id="t-calc">Armá tu presupuesto</h3>
          <p class="calc-sub">Elegí lo que necesitás y te mostramos el total.</p>

          <label class="campo">
            <span class="campo-nombre">Tu tienda</span>
            <span class="select">
              <select name="tienda">
                <option value="Lanzamiento Ecommerce" data-pesos={pesos(lanzamiento.usd)} selected>Lanzamiento · {ars(lanzamiento.usd)}</option>
                <option value="Rediseño" data-pesos={pesos(rediseno.usd)}>Rediseño · {ars(rediseno.usd)}</option>
                <option value="" data-pesos="0">Ya tengo tienda</option>
              </select>
            </span>
          </label>

          {multis.map((m) => (
            <div class="campo">
              <span class="campo-nombre" id={`t-${m.id}`}>{m.titulo}</span>
              <details class="multi" data-tipo={m.tipo}>
                <summary aria-labelledby={`t-${m.id}`}>
                  <span class="multi-texto" data-vacio={m.vacio}>{m.vacio}</span>
                </summary>
                <div class="multi-panel" role="group" aria-labelledby={`t-${m.id}`}>
                  {m.opciones.map((o, i) => (
                    <Fragment>
                    {o.grupo && o.grupo !== m.opciones[i - 1]?.grupo && <p class="multi-grupo">{o.nombre} <span>· elegí una opción</span></p>}
                    <label class={`multi-op${o.grupo ? ' multi-op-sub' : ''}`}>
                      <input type="checkbox" value={o.id} data-nombre={o.nombre} data-detalle={o.detalle} data-pesos={o.pesos} data-grupo={o.grupo || ''} data-desde={o.desde ? '1' : ''} data-definir={o.definir ? '1' : ''} />
                      <span class="multi-caja" set:html={svg('<path d="m6 12.5 4 4 8-9"/>', 'stroke-width="2.4"')} />
                      <span class="multi-nombre">{o.grupo ? o.detalle : <Fragment>{o.nombre}<small>{o.detalle}</small></Fragment>}</span>
                      <span class="mono">{o.definir ? 'A definir' : `${o.desde ? 'desde ' : ''}${fmt(o.pesos)}${m.tipo === 'mensual' ? '/mes' : ''}`}</span>
                    </label>
                    </Fragment>
                  ))}
                </div>
              </details>
            </div>
          ))}

          <div class="total" aria-live="polite">
            <div>
              <p class="mono">Pago único</p>
              <p class="total-num" data-total-unico>{ars(lanzamiento.usd)}</p>
              <p class="definir" data-definir hidden>+ ítems a definir en la llamada</p>
            </div>
            <div data-fila-mensual hidden>
              <p class="mono">Por mes</p>
              <p class="total-num" data-total-mensual>$ 0</p>
            </div>
          </div>
          <button type="submit" class="boton boton-amarillo boton-ancho">Sumar</button>
          <p class="nota">{notaPrecios}</p>
        </form>
      </div>
    </section>

    <!-- QUIÉN SOY -->
    <section id="quien-soy" class="seccion envoltura" aria-labelledby="t-quien">
      <div class="tarjeta quien">
        <div class="avatar" aria-hidden="true"><span>T</span></div>
        <div>
          <p class="ojo">03 · Detrás del estudio</p>
          <h2 id="t-quien" class="titulo-seccion">Quién soy</h2>
          <p class="mono quien-rol">{quienSoy.nombre} · {quienSoy.rol}</p>
          {quienSoy.parrafos.map((p) => <p class="quien-texto">{p}</p>)}
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="seccion envoltura faq-zona" aria-labelledby="t-faq">
      <div class="faq-titulo">
        <p class="ojo">04 · Dudas</p>
        <h2 id="t-faq" class="titulo-seccion">FAQ's</h2>
        <p class="suave">¿No encontrás tu respuesta? Escribinos por <a href={wa} target="_blank" rel="noopener">WhatsApp</a>.</p>
      </div>
      <div class="faq">
        {preguntas.map((q) => (
          <details>
            <summary>{q.p}</summary>
            <p>{q.r}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- CTA FINAL -->
    <section class="seccion envoltura" aria-labelledby="potencia-2">
      <div class="cta">
        <span class="forma forma-1" aria-hidden="true"></span>
        <span class="forma forma-2" aria-hidden="true"></span>
        <div class="cta-texto">
          <h2 id="potencia-2">Potenciá tu marca</h2>
          <p>Contanos qué vendés y en 30 minutos vemos cómo llevar tu tienda al próximo nivel.</p>
        </div>
        <a href={consulta} class="cta-caja" target="_blank" rel="noopener">
          <span class="mono">30 minutos · sin costo</span>
          <strong>Agendá consulta gratis</strong>
          <span class="cta-flecha" set:html={flecha} />
        </a>
      </div>
    </section>
  </main>

  <a href="#inicio" class="arriba" aria-label="Volver arriba">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 16V4m-5 5 5-5 5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </a>

  <footer class="pie">
    <div class="envoltura pie-in">
      <a href="#inicio" class="marca" aria-label="Toto Studio, inicio" set:html={logoSvg} />
      <ul class="pie-links">
        <li><a href={`mailto:${contacto.email}`}>{contacto.email}</a></li>
        <li><a href={wa} target="_blank" rel="noopener">WhatsApp {contacto.whatsappVisible}</a></li>
        <li><a href={tiktok} target="_blank" rel="noopener">TikTok @{contacto.tiktok}</a></li>
      </ul>
      <p class="suave pie-copy">© {anio} Toto Studio · Buenos Aires</p>
    </div>
  </footer>
</Base>

<script>
  const form = document.getElementById('calculadora') as HTMLFormElement | null;
  if (form) {
    const destino = form.dataset.form || '';
    const fmt = (n: number) => '$ ' + n.toLocaleString('es-AR');
    const unicoEl = form.querySelector('[data-total-unico]')!;
    const mensualEl = form.querySelector('[data-total-mensual]')!;
    const filaMensual = form.querySelector('[data-fila-mensual]') as HTMLElement;
    const definirEl = form.querySelector('[data-definir]') as HTMLElement;
    const multis = [...form.querySelectorAll<HTMLDetailsElement>('.multi')];

    const calcular = () => {
      let unico = 0;
      let mensual = 0;
      let desde = false;
      let definir = false;
      const items: string[] = [];

      const tienda = form.querySelector('select[name="tienda"]') as HTMLSelectElement;
      const op = tienda.selectedOptions[0];
      if (op && op.value) {
        unico += Number(op.dataset.pesos || 0);
        items.push(op.value);
      }

      multis.forEach((m) => {
        const marcados = [...m.querySelectorAll<HTMLInputElement>('input:checked')];
        const texto = m.querySelector('.multi-texto') as HTMLElement;
        texto.textContent = marcados.length
          ? marcados.map((i) => (i.dataset.grupo ? `${i.dataset.nombre} (${i.dataset.detalle})` : i.dataset.nombre)).join(', ')
          : texto.dataset.vacio || '';
        m.classList.toggle('activa', marcados.length > 0);
        marcados.forEach((i) => {
          const monto = Number(i.dataset.pesos || 0);
          const etiqueta = i.dataset.grupo ? `${i.dataset.nombre}: ${i.dataset.detalle}` : i.dataset.nombre || '';
          if (i.dataset.definir) definir = true;
          if (m.dataset.tipo === 'mensual') {
            mensual += monto;
            if (i.dataset.desde) desde = true;
            items.push(`${etiqueta} (mensual)`);
          } else {
            unico += monto;
            items.push(i.dataset.definir ? `${etiqueta} (a definir)` : etiqueta);
          }
        });
      });

      unicoEl.textContent = fmt(unico);
      mensualEl.textContent = (desde ? 'desde ' : '') + fmt(mensual);
      filaMensual.hidden = mensual === 0;
      definirEl.hidden = !definir;
      return { unico, mensual, desde, definir, items };
    };

    form.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.type === 'checkbox' && t.checked && t.dataset.grupo) {
        form.querySelectorAll<HTMLInputElement>(`input[data-grupo="${t.dataset.grupo}"]`).forEach((o) => {
          if (o !== t) o.checked = false;
        });
      }
      calcular();
    });

    // Un solo desplegable abierto a la vez; se cierra al tocar afuera o con Escape
    multis.forEach((m) =>
      m.addEventListener('toggle', () => {
        if (m.open) multis.forEach((o) => o !== m && (o.open = false));
      }),
    );
    document.addEventListener('click', (e) => {
      multis.forEach((m) => {
        if (m.open && !m.contains(e.target as Node)) m.open = false;
      });
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') multis.forEach((m) => (m.open = false));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const r = calcular();
      const total =
        fmt(r.unico) +
        (r.mensual ? ` + ${r.desde ? 'desde ' : ''}${fmt(r.mensual)}/mes` : '') +
        (r.definir ? ' + ítems a definir' : '');
      const params = new URLSearchParams({
        seleccion: r.items.join('\n') || 'Sin selección',
        total,
        origen: 'calculadora',
      });
      window.open(`${destino}?${params.toString()}`, '_blank', 'noopener');
    });
    calcular();
  }

  const arriba = document.querySelector('.arriba') as HTMLElement | null;
  if (arriba) {
    const mostrar = () => arriba.classList.toggle('visible', window.scrollY > 600);
    window.addEventListener('scroll', mostrar, { passive: true });
    mostrar();
  }
</script>

<style>
  .azul { color: var(--sello); }
  .mono { font-family: var(--mono); font-size: 0.8125rem; letter-spacing: 0.01em; }
  .suave { color: var(--tinta-suave); }
  .ojo {
    display: inline-flex; align-items: center; gap: 0.5rem;
    font-family: var(--mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--sello); margin-bottom: 0.75rem;
  }
  .punto { width: 0.5rem; height: 0.5rem; border-radius: 50%; background: var(--verde); box-shadow: 0 0 0 4px color-mix(in srgb, var(--verde) 20%, transparent); }

  /* Barra */
  .barra {
    position: sticky; top: 0; z-index: 20;
    background: color-mix(in srgb, var(--papel) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .barra-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .marca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .marca :global(svg) { width: 100%; height: auto; display: block; }
  nav { display: flex; gap: 0.25rem; font-weight: 500; font-size: 0.9375rem; }
  nav a { text-decoration: none; color: var(--tinta-suave); padding: 0.4rem 0.8rem; border-radius: 999px; transition: background 0.15s ease, color 0.15s ease; }
  nav a:hover { color: var(--tinta); background: var(--superficie); }
  @media (max-width: 640px) { nav { display: none; } }

  /* Botones */
  .boton {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0.75rem 1.4rem;
    border-radius: 999px; border: 1.5px solid var(--tinta);
    background: var(--tinta); color: #fff;
    font: 600 1rem/1.2 var(--texto); text-decoration: none; cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
  }
  .boton:hover { transform: translateY(-2px); background: var(--sello); border-color: var(--sello); box-shadow: 0 10px 20px -10px var(--sello); }
