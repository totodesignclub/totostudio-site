---
// Barra superior común. En la home (inicio) las acciones aparecen recién cuando
// la tarjeta del hero sale de pantalla; en el resto de las páginas se ven siempre.
import logo from '../data/logo.svg?raw';
import { links } from '../data/site';

interface Props { inicio?: boolean }
const { inicio = false } = Astro.props;
const logoSvg = logo.replace('<svg', '<svg aria-hidden="true" focusable="false"');
const consulta = links.calendario || `${links.formulario}?origen=consulta`;
---
<header class="barra" data-barra data-ocultas={inicio ? '' : undefined}>
  <div class="envoltura barra-in">
    <a href={inicio ? '#inicio' : '/'} class="marca" aria-label="Toto &amp;Co, inicio" set:html={logoSvg} />
    <div class="barra-acciones">
      <a href={consulta} class="b b-claro" target="_blank" rel="noopener">Agendar consulta</a>
    </div>
  </div>
</header>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra][data-ocultas]');
  const hero = document.querySelector('[data-hero-card]');
  if (barra) {
    if (hero && 'IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => {
        barra.classList.toggle('con-acciones', !e.isIntersecting && e.boundingClientRect.bottom < 0);
      }).observe(hero);
    } else {
      barra.classList.add('con-acciones');
    }
  }
</script>

<style>
  .barra {
    position: sticky; top: 0; z-index: 30;
    background: color-mix(in srgb, var(--papel) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--linea);
  }
  .barra-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 4rem; }
  .marca { display: inline-flex; color: var(--tinta); width: 7.5rem; }
  .marca :global(svg) { width: 100%; height: auto; display: block; }
  .barra-acciones { display: flex; gap: 0.5rem; transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s; }
  [data-ocultas]:not(.con-acciones) .barra-acciones { opacity: 0; visibility: hidden; transform: translateY(-6px); pointer-events: none; }
  .b {
    display: inline-flex; align-items: center; justify-content: center; white-space: nowrap;
    min-height: 2.5rem; padding: 0.45rem 1.05rem; border-radius: 999px;
    border: 1.5px solid var(--tinta); background: var(--tinta); color: #fff;
    font: 600 0.9rem/1.2 var(--texto); text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }
  .b:hover { background: var(--sello); border-color: var(--sello); }
  .b-claro { background: transparent; color: var(--tinta); }
  .b-claro:hover { background: var(--tinta); border-color: var(--tinta); color: #fff; }
  @media (max-width: 420px) {
    .marca { width: 5.5rem; }
    .barra-acciones { gap: 0.35rem; }
    .b { min-height: 2.25rem; padding-inline: 0.7rem; font-size: 0.8125rem; }
  }
  @media (prefers-reduced-motion: reduce) { .barra-acciones { transition: none; } }
</style>
